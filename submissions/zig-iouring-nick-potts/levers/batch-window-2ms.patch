+/// Fills every connection that has room with new Sync groups, encoded into its pending bytes. Returns when the
+/// reads it held back are due (monotonic ns), if it held any.
+pub fn pump() ?u64 {
     for (conns) |*c| {
         const limit: u8 = if (c.write) 1 else cfg.depth;
         while (c.in_len < limit) {
+            if (!c.write and readsDue() != null) break;
