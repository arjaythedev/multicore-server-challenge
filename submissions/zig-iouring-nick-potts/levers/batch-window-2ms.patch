             encodeGroup(&c.pending, g);
             c.pushGroup(g);
         }
     }
+    return readsDue();
+}
+
+/// When the queued reads should go out, or null if they may go now (or none are queued).
+fn readsDue() ?u64 {
+    const s = oldestRead() orelse return null;
+    const due = reads[@intFromEnum(s)].head.?.queued_ns + cfg.window_ns;
+    if (due <= now_ns) return null;
+    var cost: u32 = 0;
+    for (&reads, 0..) |*q, i| cost += cost_us[i] * q.len;
+    return if (cost >= cfg.budget_us) null else due;
 }
 
