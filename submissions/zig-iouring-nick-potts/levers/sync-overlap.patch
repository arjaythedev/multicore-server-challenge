 /// Fills every connection that has room with new Sync groups, encoded into its pending bytes.
 pub fn pump() void {
-    for (conns) |*c| {
-        const limit: u8 = if (c.write) 1 else cfg.depth;
-        while (c.in_len < limit) {
-            const g = (if (c.write) buildWrite() else buildRead()) orelse break;
-            encodeGroup(&c.pending, g);
-            c.pushGroup(g);
-        }
+    for (conns) |*c| _ = fill(c, 0);
+}
+
+/// Encodes new Sync groups into the connection's pending bytes while it has room, counting `done` groups whose
+/// results already arrived as gone. Returns whether it added any.
+fn fill(c: *Conn, done: u8) bool {
+    const limit: u8 = if (c.write) 1 else cfg.depth;
+    var added = false;
+    while (c.in_len - done < limit) {
+        const g = (if (c.write) buildWrite() else buildRead()) orelse break;
+        encodeGroup(&c.pending, g);
+        c.pushGroup(g);
+        added = true;
+    }
+    return added;
+}
+
+/// Before the received results are rendered, gives the read connection its next groups for the ones whose
+/// ReadyForQuery already arrived, so Postgres starts on them while this worker renders. Returns whether it added any.
+pub fn refill(c: *Conn) bool {
+    if (c.write) return false;
+    var done: u8 = 0;
+    var at = c.rstart;
+    while (c.rend - at >= 5) {
+        const len: usize = @intCast(std.mem.readInt(i32, c.rbuf[at + 1 ..][0..4], .big));
+        if (c.rend - at < 1 + len) break;
+        if (c.rbuf[at] == 'Z') done += 1;
+        at += 1 + len;
     }
+    return done > 0 and fill(c, done);
 }
 
 // ---------------------------------------------------------------- results
