<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure facts (no database), and BatchTests: the read-batching property against a copy
         of the dev seed (check.sh phase 4 provides it; phase 2 leaves it out). The end-to-end
         proof is the conformance suite, which check.sh runs against the real server. -->
    <Compile Include="JwtTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="BcryptTests.fs" />
    <Compile Include="BatchTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.104" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="FsCheck" Version="3.3.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web\Web.fsproj" />
  </ItemGroup>
</Project>
