<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The database side, as in sss8: typed records in, typed records out, SQL in one
         place per resource. No HTTP here, and no token cryptography (that is Web.Jwt). -->
    <Compile Include="Types.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Commit.fs" />
    <Compile Include="Reads.fs" />
    <Compile Include="Bcrypt.fs" />
    <Compile Include="Passwords.fs" />
    <Compile Include="Tags.fs" />
    <Compile Include="Users.fs" />
    <Compile Include="Profiles.fs" />
    <Compile Include="Articles.fs" />
    <Compile Include="Comments.fs" />
  </ItemGroup>
  <!-- bcrypt's Blowfish is C and assembly (native/): built here, so that every build, publish and
       test run has libcbcrypt.so beside its assemblies (it travels with Engine.dll to the
       projects that reference this one). Needs gcc and python3 (install.sh). -->
  <PropertyGroup>
    <NativeDir>$(MSBuildProjectDirectory)/../../native</NativeDir>
    <NativeLibrary>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)native/libcbcrypt.so</NativeLibrary>
  </PropertyGroup>
  <Target Name="NativeBcrypt" BeforeTargets="AssignTargetPaths" Inputs="$(NativeDir)/cbcrypt.c;$(NativeDir)/gen-bcrypt-x86.py;$(NativeDir)/build.sh" Outputs="$(NativeLibrary)">
    <Exec Command="bash &quot;$(NativeDir)/build.sh&quot; &quot;$(NativeLibrary)&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeLibrary)" Link="libcbcrypt.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.FSharp" Version="5.7.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>
</Project>
