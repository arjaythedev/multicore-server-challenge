<Project>
  <!-- As in sss8: warnings are errors, so a sloppy match or an unused binding never ships. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <Nullable>disable</Nullable>
    <!-- rule 11: pinned dependencies. Every project restores from its packages.lock.json
         (build.sh restores with locked-mode, so a drifted graph is a failed build). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
