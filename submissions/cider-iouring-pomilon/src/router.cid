        var limit_val: int = 20;
        var offset_val: int = 0;
        if (http_parse_limit(req->query_ptr, req->query_len, &limit_val) < 0) {
            *out_len = fmt_error_response(422, "invalid limit", out, cap);
            return 0;
        }
        if (http_parse_offset(req->query_ptr, req->query_len, &offset_val) < 0) {
            *out_len = fmt_error_response(422, "invalid offset", out, cap);
            return 0;
        }
        native_itoa(limit_val as i64, (&slot->lim_buf[0]) as *char);
        native_itoa(offset_val as i64, (&slot->off_buf[0]) as *char);

        var conn: *PgConn = pg_get_read_conn();
        if (conn as i64 == 0 as i64) {
            return -2;
        }
        var p_feed: [*char; 3] = [v_str, (&slot->lim_buf[0]) as *char, (&slot->off_buf[0]) as *char];
        PQsendQueryPrepared(conn->c, "s_feed", 3, &p_feed[0], 0 as *int, 0 as *int, 0);
        PQsendPipelineSync(conn->c);
        pg_enqueue_slot(conn, slot_idx);
        slot->route_id = ROUTE_ARTICLES_FEED;
        return 1;
    }

    // Route: Articles by slug: /api/articles/:slug...
    if (req->path_len > 14 && native_memcmp(req->path_ptr, "/api/articles/", 14) == 0) {
        var rest: *char = (req->path_ptr as i64 + 14) as *char;
        var rlen: int = req->path_len - 14;

        // Check for "/favorite"
        if (rlen > 9 && native_memcmp((rest as i64 + (rlen as i64) - 9) as *char, "/favorite", 9) == 0) {
            var slen_act: int = rlen - 9;
            if (slen_act > 240) { *out_len = fmt_error_response(404, "not found", out, cap); return 0; }
            native_memcpy((&slot->param1[0]) as *char, rest, slen_act as i64);
            slot->param1[slen_act] = 0 as u8;

            if (req->method != 2 && req->method != 4) {
                *out_len = fmt_error_response(404, "not found", out, cap);
                return 0;
            }
            if (slot->auth_status <= 0 || slot->viewer_id <= 0) {
                *out_len = fmt_error_response(401, "unauthorized", out, cap);
                return 0;
            }

            var p_slug: [*char; 1] = [(&slot->param1[0]) as *char];
            var conn: *PgConn = pg_get_read_conn();
            if (conn as i64 == 0 as i64) {
                return -2;
            }
            PQsendQueryPrepared(conn->c, "s_article_owner", 1, &p_slug[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(conn->c);
            pg_enqueue_slot(conn, slot_idx);
            slot->route_id = ROUTE_ARTICLE_FAVORITE;
            slot->sub_id = req->method; // 2 = POST favorite, 4 = DELETE unfavorite
            slot->step = 1;
            return 1;
        }

        // Check for "/comments"
        var comm_idx: int = -1;
        var r_base: i64 = rest as i64;
        for (var i: int = 0; i + 9 <= rlen; i = i + 1) {
            if (native_memcmp((r_base + (i as i64)) as *char, "/comments", 9) == 0) {
                comm_idx = i;
                break;
            }
        }

        if (comm_idx > 0) {
            if (comm_idx > 240) { *out_len = fmt_error_response(404, "not found", out, cap); return 0; }
            native_memcpy((&slot->param1[0]) as *char, rest, comm_idx as i64);
            slot->param1[comm_idx] = 0 as u8;

            if (rlen == comm_idx + 9) { // Exactly "/comments"
                if (req->method == 2) { // POST comment
                    if (slot->auth_status <= 0 || slot->viewer_id <= 0) {
                        *out_len = fmt_error_response(401, "unauthorized", out, cap);
                        return 0;
                    }
                    var wconn: *PgConn = pg_get_write_conn();
                    if (wconn as i64 == 0 as i64) {
                        return -4;
                    }
                    if (json_has_wrapper(req->body_ptr, req->body_len, "comment", 7) == 0) {
                        *out_len = fmt_error_response(422, "missing comment wrapper", out, cap);
                        return 0;
                    }
                    var c_body: *char = 0 as *char;
                    var c_blen: int = 0;
                    var st_c: int = json_find_str(req->body_ptr, req->body_len, "body", 4, &c_body, &c_blen);
                    if (st_c <= 0 || c_blen == 0) {
                        *out_len = fmt_error_response(422, "body can't be empty", out, cap);
                        return 0;
                    }
                    var c_unescaped: *char = get_scratch();
                    if (c_blen >= 262144 || json_unescape(c_body, c_blen, c_unescaped, 262144) < 0) {
                        *out_len = fmt_error_response(422, "comment too long", out, cap);
                        return 0;
                    }

                    var p_ins: [*char; 3] = [(&slot->param1[0]) as *char, v_str, c_unescaped];
                    PQsendQueryPrepared(wconn->c, "s_comment_insert", 3, &p_ins[0], 0 as *int, 0 as *int, 0);
                    PQsendPipelineSync(wconn->c);
                    pg_enqueue_slot(wconn, slot_idx);
                    slot->route_id = ROUTE_COMMENTS_CREATE;
                    return 1;
                } else if (req->method == 1) { // GET comments
                    slot->route_id = ROUTE_COMMENTS_GET;
                    slot->p1_len = comm_idx;
                    var conn: *PgConn = pg_get_read_conn();
                    if (conn as i64 == 0 as i64) {
                        return -2;
                    }
                    slot->next_coalesced = -1;

                    var p_c: [*char; 2] = [v_str, (&slot->param1[0]) as *char];
                    PQsendQueryPrepared(conn->c, "s_comments_by_slug", 2, &p_c[0], 0 as *int, 0 as *int, 0);
                    PQsendPipelineSync(conn->c);
                    pg_enqueue_slot(conn, slot_idx);
                    return 1;
                }
            } else if (rlen > comm_idx + 10 && *(((r_base + (comm_idx as i64) + 9)) as *u8) == 47 as u8) { // "/comments/:id"
                var cid_ptr: *char = (r_base + (comm_idx as i64) + 10) as *char;
                var cid_len: int = rlen - comm_idx - 10;
                if (cid_len > 240) { *out_len = fmt_error_response(404, "not found", out, cap); return 0; }
                native_memcpy((&slot->param2[0]) as *char, cid_ptr, cid_len as i64);
                slot->param2[cid_len] = 0 as u8;

                // Validate cid is all digits
                for (var i: int = 0; i < cid_len; i = i + 1) {
                    var ch: u8 = slot->param2[i];
                    if (ch < (48 as u8) || ch > (57 as u8)) {
                        *out_len = fmt_error_response(404, "invalid comment id", out, cap);
                        return 0;
                    }
                }

                if (req->method == 4) { // DELETE comment
                    if (slot->auth_status <= 0 || slot->viewer_id <= 0) {
                        *out_len = fmt_error_response(401, "unauthorized", out, cap);
                        return 0;
                    }
                    var p_own: [*char; 2] = [(&slot->param2[0]) as *char, (&slot->param1[0]) as *char];
                    var conn: *PgConn = pg_get_read_conn();
                    if (conn as i64 == 0 as i64) {
                        return -2;
                    }
                    PQsendQueryPrepared(conn->c, "s_comment_owner", 2, &p_own[0], 0 as *int, 0 as *int, 0);
                    PQsendPipelineSync(conn->c);
                    pg_enqueue_slot(conn, slot_idx);
                    slot->route_id = ROUTE_COMMENTS_DELETE;
                    slot->step = 1;
                    return 1;
                }
            }
        }

        // Single article: /api/articles/:slug
        if (rlen > 240) { *out_len = fmt_error_response(404, "not found", out, cap); return 0; }
        native_memcpy((&slot->param1[0]) as *char, rest, rlen as i64);
        slot->param1[rlen] = 0 as u8;

        if (req->method == 1) { // GET /api/articles/:slug
            slot->route_id = ROUTE_ARTICLE_GET;
            slot->p1_len = rlen;
            var conn: *PgConn = pg_get_read_conn();
            if (conn as i64 == 0 as i64) {
                return -2;
            }
            slot->next_coalesced = -1;

            var p_art: [*char; 2] = [v_str, (&slot->param1[0]) as *char];
            PQsendQueryPrepared(conn->c, "s_article_by_slug", 2, &p_art[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(conn->c);
            pg_enqueue_slot(conn, slot_idx);
            return 1;
        } else if (req->method == 3) { // PUT /api/articles/:slug
            if (slot->auth_status <= 0 || slot->viewer_id <= 0) {
                *out_len = fmt_error_response(401, "unauthorized", out, cap);
                return 0;
            }
            if (json_has_wrapper(req->body_ptr, req->body_len, "article", 7) == 0) {
                *out_len = fmt_error_response(422, "missing article wrapper", out, cap);
                return 0;
            }
            var u_title: *char = 0 as *char;
            var u_tlen: int = 0;
            var has_title: int = json_find_str(req->body_ptr, req->body_len, "title", 5, &u_title, &u_tlen);
            if (has_title < 0) {
                *out_len = fmt_error_response(422, "title invalid", out, cap);
                return 0;
            }
            if (has_title == 1 && (u_tlen == 0 || u_tlen >= 512)) {
                *out_len = fmt_error_response(422, "title can't be empty or too long", out, cap);
                return 0;
            }

            var u_desc: *char = 0 as *char;
            var u_dlen: int = 0;
            var has_desc: int = json_find_str(req->body_ptr, req->body_len, "description", 11, &u_desc, &u_dlen);
            if (has_desc < 0) {
                *out_len = fmt_error_response(422, "description invalid", out, cap);
                return 0;
            }
            if (has_desc == 1 && u_dlen >= 1024) {
                *out_len = fmt_error_response(422, "description too long", out, cap);
                return 0;
            }

            var u_body: *char = 0 as *char;
            var u_blen: int = 0;
            var has_body: int = json_find_str(req->body_ptr, req->body_len, "body", 4, &u_body, &u_blen);
            if (has_body < 0) {
                *out_len = fmt_error_response(422, "body invalid", out, cap);
                return 0;
            }
            if (has_body == 1 && u_blen >= 262144) {
                *out_len = fmt_error_response(422, "body too long", out, cap);
                return 0;
            }

            var p_own: [*char; 1] = [(&slot->param1[0]) as *char];
            var conn: *PgConn = pg_get_read_conn();
            if (conn as i64 == 0 as i64) {
                return -2;
            }
            PQsendQueryPrepared(conn->c, "s_article_owner", 1, &p_own[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(conn->c);
            pg_enqueue_slot(conn, slot_idx);
            slot->route_id = ROUTE_ARTICLE_UPDATE;
            slot->sub_id = (req->body_ptr as i64 - (&slot->read_buf[0]) as i64) as int;
            slot->p2_len = req->body_len;
            slot->step = 1;
            return 1;
        } else if (req->method == 4) { // DELETE /api/articles/:slug
            if (slot->auth_status <= 0 || slot->viewer_id <= 0) {
                *out_len = fmt_error_response(401, "unauthorized", out, cap);
                return 0;
            }
            var p_own: [*char; 1] = [(&slot->param1[0]) as *char];
            var conn: *PgConn = pg_get_read_conn();
            if (conn as i64 == 0 as i64) {
                return -2;
            }
            PQsendQueryPrepared(conn->c, "s_article_owner", 1, &p_own[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(conn->c);
            pg_enqueue_slot(conn, slot_idx);
            slot->route_id = ROUTE_ARTICLE_DELETE;
            slot->step = 1;
            return 1;
        }
    }

    // Default 404
    *out_len = fmt_error_response(404, "not found", out, cap);
    return 0;
}

func route_login_finish(slot: *ConnSlot, ok: int, secret: *char, slen: int, out: *char, cap: int) -> int {
    slot->write_offset = 0;
    if (slot->num_res <= 0) {
        slot->num_res = 0;
        return fmt_error_response(500, "database result missing", out, cap);
    }
    var res: *void = slot->res[0];
    if (res as i64 == 0 as i64) {
        slot->num_res = 0;
        return fmt_error_response(500, "database result missing", out, cap);
    }
    if (ok == 0) {
        PQclear(res);
        slot->res[0] = 0 as *void;
        slot->num_res = 0;
        return fmt_error_response(401, "invalid email or password", out, cap);
    }
    var uid_str: *char = PQgetvalue(res, 0, 0);
    var uid: i64 = native_atoi(uid_str) as i64;
    var username: *char = PQgetvalue(res, 0, 1);
    var email: *char = PQgetvalue(res, 0, 2);
    var bio: *char = PQgetvalue(res, 0, 3);
    var bio_null: int = PQgetisnull(res, 0, 3);
    var image: *char = PQgetvalue(res, 0, 4);
    var image_null: int = PQgetisnull(res, 0, 4);

    var tok_buf: [u8; 256] = uninit;
    jwt_sign(uid, secret, slen, (&tok_buf[0]) as *char);

    var bw: BufWriter = uninit;
    bw.buf = ((out as i64) + 128 as i64) as *char;
    bw.len = 0;
    bw.cap = cap - 128;
    render_user_json(&bw, email, (&tok_buf[0]) as *char, username, bio, bio_null, image, image_null);
    PQclear(res);
    slot->res[0] = 0 as *void;
    slot->num_res = 0;
    return finish_json_response(slot, 200, bw.len, out);
}

func route_finish(slot: *ConnSlot, slot_idx: int, secret: *char, slen: int, out: *char, cap: int) -> int {
    slot->write_offset = 0;
    router_clear_inflight(slot, slot_idx);
    var v_str: *char = (&slot->v_buf[0]) as *char;
    if (slot->num_res <= 0) {
        slot->num_res = 0;
        return fmt_error_response(500, "database result missing", out, cap);
    }

    if (slot->route_id == ROUTE_TAGS) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            return fmt_error_response(500, "database error", out, cap);
        }
        var tags_json: *char = PQgetvalue(res, 0, 0);
        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        buf_append_str(&bw, "{\"tags\":");
        buf_append_str(&bw, tags_json);
        buf_append_char(&bw, 125);
        PQclear(res);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_USER_REGISTER) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            return fmt_error_response(422, "username or email is already taken", out, cap);
        }
        var new_id_str: *char = PQgetvalue(res, 0, 0);
        var new_id: i64 = native_atoi(new_id_str) as i64;
        var tok_buf: [u8; 256] = uninit;
        jwt_sign(new_id, secret, slen, (&tok_buf[0]) as *char);

        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        render_user_json(&bw, (&slot->param2[0]) as *char, (&tok_buf[0]) as *char, (&slot->param1[0]) as *char, 0 as *char, 1, 0 as *char, 1);
        PQclear(res);
        return finish_json_response(slot, 201, bw.len, out);
    }

    if (slot->route_id == ROUTE_USER_LOGIN) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            slot->num_res = 0;
            return fmt_error_response(401, "invalid email or password", out, cap);
        }
        var db_hash: *char = PQgetvalue(res, 0, 5);
        var hlen: int = str_len(db_hash);
        if (hlen > 64) { hlen = 64; }

        if (g_num_bcrypt > 0) {
            var best: int = 0;
            var min_load: int = g_bcrypt_load[0];
            for (var bi: int = 1; bi < g_num_bcrypt; bi = bi + 1) {
                if (g_bcrypt_load[bi] < min_load) {
                    min_load = g_bcrypt_load[bi];
                    best = bi;
                }
            }
            g_bcrypt_load[best] = g_bcrypt_load[best] + 1;
            var bfd: int = g_bcrypt_fds[best];

            var job: BcryptJob = uninit;
            job.slot_idx = (best << 28) | (slot_idx & 0x0FFFFFFF);
            job.pw_len = slot->p2_len;
            if (job.pw_len > 72) { job.pw_len = 72; }
            job.hash_len = hlen;
            native_memcpy((&job.pw[0]) as *char, (&slot->param2[0]) as *char, job.pw_len as i64);
            native_memcpy((&job.hash[0]) as *char, db_hash, hlen as i64);

            sys_write(bfd, (&job) as *void, sizeof(BcryptJob) as i64);
            slot->state = STATE_WAIT_BCRYPT;
            return -3; // Pending async bcrypt
        }

        if (bcrypt_verify((&slot->param2[0]) as *char, slot->p2_len, db_hash, hlen) == 0) {
            PQclear(res);
            slot->num_res = 0;
            return fmt_error_response(401, "invalid email or password", out, cap);
        }
        return route_login_finish(slot, 1, secret, slen, out, cap);
    }

    if (slot->route_id == ROUTE_USER_CURRENT) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            return fmt_error_response(401, "user not found", out, cap);
        }
        var username: *char = PQgetvalue(res, 0, 1);
        var email: *char = PQgetvalue(res, 0, 2);
        var bio: *char = PQgetvalue(res, 0, 3);
        var bio_null: int = PQgetisnull(res, 0, 3);
        var image: *char = PQgetvalue(res, 0, 4);
        var image_null: int = PQgetisnull(res, 0, 4);

        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        render_user_json(&bw, email, (&slot->param1[0]) as *char, username, bio, bio_null, image, image_null);
        PQclear(res);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_USER_UPDATE) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            return fmt_error_response(422, "username or email already taken", out, cap);
        }
        var username: *char = PQgetvalue(res, 0, 1);
        var email: *char = PQgetvalue(res, 0, 2);
        var bio: *char = PQgetvalue(res, 0, 3);
        var bio_null: int = PQgetisnull(res, 0, 3);
        var image: *char = PQgetvalue(res, 0, 4);
        var image_null: int = PQgetisnull(res, 0, 4);

        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        render_user_json(&bw, email, (&slot->param1[0]) as *char, username, bio, bio_null, image, image_null);
        PQclear(res);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_PROFILE) {
        var res: *void = slot->res[0];
        if (PQresultStatus(res) != PGRES_TUPLES_OK || PQntuples(res) == 0) {
            PQclear(res);
            return fmt_error_response(404, "profile not found", out, cap);
        }
        var username: *char = PQgetvalue(res, 0, 1);
        var bio: *char = PQgetvalue(res, 0, 2);
        var bio_null: int = PQgetisnull(res, 0, 2);
        var image: *char = PQgetvalue(res, 0, 3);
        var image_null: int = PQgetisnull(res, 0, 3);
        var fol_str: *char = PQgetvalue(res, 0, 4);
        var fol: int = 0;
        if (*(((fol_str as i64)) as *u8) == 116 as u8) { fol = 1; }

        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        render_profile_json(&bw, username, bio, bio_null, image, image_null, fol);
        PQclear(res);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_PROFILE_FOLLOW) {
        if (slot->step == 1) {
            var res_u: *void = slot->res[0];
            if (PQresultStatus(res_u) != PGRES_TUPLES_OK || PQntuples(res_u) == 0) {
                PQclear(res_u);
                return fmt_error_response(404, "profile not found", out, cap);
            }
            var tid_str: *char = PQgetvalue(res_u, 0, 0);
            var tid_len: int = native_strlen(tid_str) as int;
            native_memcpy((&slot->param2[0]) as *char, tid_str, tid_len as i64);
            slot->param2[tid_len] = 0 as u8;
            PQclear(res_u);
            slot->num_res = 0;

            var p_fol: [*char; 2] = [v_str, (&slot->param2[0]) as *char];
            var wconn: *PgConn = pg_get_write_conn_force();
            if (slot->sub_id == 2) {
                PQsendQueryPrepared(wconn->c, "s_follow", 2, &p_fol[0], 0 as *int, 0 as *int, 0);
            } else {
                PQsendQueryPrepared(wconn->c, "s_unfollow", 2, &p_fol[0], 0 as *int, 0 as *int, 0);
            }
            var p_prof: [*char; 2] = [v_str, (&slot->param1[0]) as *char];
            PQsendQueryPrepared(wconn->c, "s_profile", 2, &p_prof[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1; // Wait for step 2
        } else if (slot->step == 2) {
            if (slot->num_res < 2) {
                for (var ri: int = 0; ri < slot->num_res; ri = ri + 1) { PQclear(slot->res[ri]); slot->res[ri] = 0 as *void; }
                slot->num_res = 0;
                return fmt_error_response(500, "database write failed", out, cap);
            }
            var res_f: *void = slot->res[0];
            var res: *void = slot->res[1];
            slot->res[0] = 0 as *void;
            slot->res[1] = 0 as *void;
            if (res_ok_command(res_f) == 0 || res_ok_tuples(res) == 0 || PQntuples(res) == 0) {
                PQclear(res_f);
                PQclear(res);
                slot->num_res = 0;
                return fmt_error_response(500, "database write failed", out, cap);
            }
            var username: *char = PQgetvalue(res, 0, 1);
            var bio: *char = PQgetvalue(res, 0, 2);
            var bio_null: int = PQgetisnull(res, 0, 2);
            var image: *char = PQgetvalue(res, 0, 3);
            var image_null: int = PQgetisnull(res, 0, 3);
            var fol: int = 0;
            if (slot->sub_id == 2) { fol = 1; }

            var bw: BufWriter = uninit;
            bw.buf = ((out as i64) + 128 as i64) as *char;
            bw.len = 0;
            bw.cap = cap - 128;
            render_profile_json(&bw, username, bio, bio_null, image, image_null, fol);
            PQclear(res_f);
            PQclear(res);
            slot->num_res = 0;
            return finish_json_response(slot, 200, bw.len, out);
        }
    }

    if (slot->route_id == ROUTE_ARTICLES_LIST || slot->route_id == ROUTE_ARTICLES_FEED) {
        var res: *void = slot->res[0];
        if (res_ok_tuples(res) == 0 || PQntuples(res) <= 0) {
            PQclear(res);
            slot->num_res = 0;
            return fmt_error_response(500, "database error", out, cap);
        }
        var count_str: *char = PQgetvalue(res, 0, 0);
        var has_articles: int = 0;
        var n: int = PQntuples(res);
        if (PQgetisnull(res, 0, 1) == 0) {
            has_articles = 1;
        }

        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        buf_append_str(&bw, "{\"articles\":[");
        if (has_articles != 0) {
            for (var i: int = 0; i < n; i = i + 1) {
                if (i > 0) { buf_append_char(&bw, 44); } // ','
                render_article_object(&bw, res, i, 0);
            }
        }
        buf_append_str(&bw, "],\"articlesCount\":");
        buf_append_str(&bw, count_str);
        buf_append_char(&bw, 125);
        PQclear(res);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_ARTICLE_GET) {
        var res_art: *void = slot->res[0];
        if (PQresultStatus(res_art) != PGRES_TUPLES_OK || PQntuples(res_art) == 0) {
            PQclear(res_art);
            return fmt_error_response(404, "article not found", out, cap);
        }
        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        buf_append_str(&bw, "{\"article\":");
        render_article_object(&bw, res_art, 0, 1);
        buf_append_char(&bw, 125);
        PQclear(res_art);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_ARTICLE_FAVORITE) {
        if (slot->step == 1) {
            var res_own: *void = slot->res[0];
            if (PQresultStatus(res_own) != PGRES_TUPLES_OK || PQntuples(res_own) == 0) {
                PQclear(res_own);
                return fmt_error_response(404, "article not found", out, cap);
            }
            var aid_str: *char = PQgetvalue(res_own, 0, 0);
            var aid_len: int = native_strlen(aid_str) as int;
            native_memcpy((&slot->param2[0]) as *char, aid_str, aid_len as i64);
            slot->param2[aid_len] = 0 as u8;
            PQclear(res_own);
            slot->num_res = 0;

            var p_fav: [*char; 2] = [v_str, (&slot->param2[0]) as *char];
            var wconn: *PgConn = pg_get_write_conn_force();
            if (slot->sub_id == 2) {
                PQsendQueryPrepared(wconn->c, "s_favorite", 2, &p_fav[0], 0 as *int, 0 as *int, 0);
            } else {
                PQsendQueryPrepared(wconn->c, "s_unfavorite", 2, &p_fav[0], 0 as *int, 0 as *int, 0);
            }
            var p_art: [*char; 2] = [v_str, (&slot->param2[0]) as *char];
            PQsendQueryPrepared(wconn->c, "s_article_by_id", 2, &p_art[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1;
        } else if (slot->step == 2) {
            if (slot->num_res < 2) {
                for (var ri: int = 0; ri < slot->num_res; ri = ri + 1) { PQclear(slot->res[ri]); slot->res[ri] = 0 as *void; }
                slot->num_res = 0;
                return fmt_error_response(500, "database write failed", out, cap);
            }
            var res_f: *void = slot->res[0];
            var res_art: *void = slot->res[1];
            slot->res[0] = 0 as *void;
            slot->res[1] = 0 as *void;
            if (res_ok_command(res_f) == 0 || res_ok_tuples(res_art) == 0 || PQntuples(res_art) == 0) {
                PQclear(res_f);
                PQclear(res_art);
                slot->num_res = 0;
                return fmt_error_response(500, "database write failed", out, cap);
            }
            var bw: BufWriter = uninit;
            bw.buf = ((out as i64) + 128 as i64) as *char;
            bw.len = 0;
            bw.cap = cap - 128;
            buf_append_str(&bw, "{\"article\":");
            render_article_object(&bw, res_art, 0, 1);
            buf_append_char(&bw, 125);
            PQclear(res_f);
            PQclear(res_art);
            slot->num_res = 0;
            return finish_json_response(slot, 200, bw.len, out);
        }
    }

    if (slot->route_id == ROUTE_COMMENTS_GET) {
        var res_c: *void = slot->res[0];
        if (PQresultStatus(res_c) != PGRES_TUPLES_OK || PQntuples(res_c) == 0) {
            PQclear(res_c);
            return fmt_error_response(404, "article not found", out, cap);
        }
        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        buf_append_str(&bw, "{\"comments\":[");
        if (PQgetisnull(res_c, 0, 0) == 0) {
            var n: int = PQntuples(res_c);
            for (var i: int = 0; i < n; i = i + 1) {
                if (i > 0) { buf_append_char(&bw, 44); } // ','
                render_comment_object(&bw, res_c, i, 1);
            }
        }
        buf_append_str(&bw, "]}");
        PQclear(res_c);
        return finish_json_response(slot, 200, bw.len, out);
    }

    if (slot->route_id == ROUTE_COMMENTS_CREATE) {
        var res_ins: *void = slot->res[0];
        if (PQresultStatus(res_ins) != PGRES_TUPLES_OK || PQntuples(res_ins) == 0) {
            PQclear(res_ins);
            return fmt_error_response(404, "article not found", out, cap);
        }
        var bw: BufWriter = uninit;
        bw.buf = ((out as i64) + 128 as i64) as *char;
        bw.len = 0;
        bw.cap = cap - 128;
        buf_append_str(&bw, "{\"comment\":");
        render_comment_object(&bw, res_ins, 0, 0);
        buf_append_char(&bw, 125);
        PQclear(res_ins);
        return finish_json_response(slot, 201, bw.len, out);
    }

    if (slot->route_id == ROUTE_COMMENTS_DELETE) {
        if (slot->step == 1) {
            var res_own: *void = slot->res[0];
            if (PQresultStatus(res_own) != PGRES_TUPLES_OK || PQntuples(res_own) == 0) {
                PQclear(res_own);
                return fmt_error_response(404, "comment not found", out, cap);
            }
            var author_id_str: *char = PQgetvalue(res_own, 0, 0);
            var author_id: i64 = native_atoi(author_id_str) as i64;
            PQclear(res_own);
            if (author_id != slot->viewer_id) {
                return fmt_error_response(403, "forbidden", out, cap);
            }
            slot->num_res = 0;
            var p_del: [*char; 1] = [(&slot->param2[0]) as *char];
            var wconn: *PgConn = pg_get_write_conn_force();
            PQsendQueryPrepared(wconn->c, "s_comment_delete", 1, &p_del[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1;
        } else if (slot->step == 2) {
            var res_del: *void = slot->res[0];
            if (res_ok_command(res_del) == 0) {
                PQclear(res_del);
                slot->num_res = 0;
                return fmt_error_response(500, "database delete failed", out, cap);
            }
            PQclear(res_del);
            slot->num_res = 0;
            return fmt_204_response(out, cap);
        }
    }

    if (slot->route_id == ROUTE_ARTICLE_CREATE) {
        if (slot->step == 1) {
            var res_ins: *void = slot->res[0];
            if (PQresultStatus(res_ins) != PGRES_TUPLES_OK || PQntuples(res_ins) == 0) {
                PQclear(res_ins);
                return fmt_error_response(500, "database insert failed", out, cap);
            }
            var new_aid_str: *char = PQgetvalue(res_ins, 0, 0);
            var aid_len: int = native_strlen(new_aid_str) as int;
            native_memcpy((&slot->param2[0]) as *char, new_aid_str, aid_len as i64);
            slot->param2[aid_len] = 0 as u8;
            PQclear(res_ins);
            slot->res[0] = 0 as *void;
            slot->num_res = 0;

            var wconn: *PgConn = pg_get_write_conn_force();
            if (wconn as i64 == 0 as i64) {
                return fmt_error_response(500, "no database connection", out, cap);
            }
            var p_art: [*char; 2] = [v_str, (&slot->param2[0]) as *char];
            PQsendQueryPrepared(wconn->c, "s_article_by_id", 2, &p_art[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1;
        } else if (slot->step == 2) {
            var res_art: *void = slot->res[0];
            if (res_ok_tuples(res_art) == 0 || PQntuples(res_art) == 0) {
                PQclear(res_art);
                slot->num_res = 0;
                return fmt_error_response(500, "article readback failed", out, cap);
            }
            var bw: BufWriter = uninit;
            bw.buf = ((out as i64) + 128 as i64) as *char;
            bw.len = 0;
            bw.cap = cap - 128;
            buf_append_str(&bw, "{\"article\":");
            render_article_object(&bw, res_art, 0, 1);
            buf_append_char(&bw, 125);
            PQclear(res_art);
            slot->num_res = 0;
            return finish_json_response(slot, 201, bw.len, out);
        }
    }

    if (slot->route_id == ROUTE_ARTICLE_UPDATE) {
        if (slot->step == 1) {
            var res_own: *void = slot->res[0];
            if (PQresultStatus(res_own) != PGRES_TUPLES_OK || PQntuples(res_own) == 0) {
                PQclear(res_own);
                return fmt_error_response(404, "article not found", out, cap);
            }
            var aid_str: *char = PQgetvalue(res_own, 0, 0);
            var author_id_str: *char = PQgetvalue(res_own, 0, 1);
            var author_id: i64 = native_atoi(author_id_str) as i64;
            var aid_len: int = native_strlen(aid_str) as int;
            native_memcpy((&slot->param2[0]) as *char, aid_str, aid_len as i64);
            slot->param2[aid_len] = 0 as u8;
            PQclear(res_own);
            slot->num_res = 0;

            if (author_id != slot->viewer_id) {
                return fmt_error_response(403, "forbidden", out, cap);
            }

            // Locate JSON body from saved offset and length
            var b_ptr: *char = ((((&slot->read_buf[0]) as *char as i64) + (slot->sub_id as i64))) as *char;
            var b_len: int = slot->p2_len;

            var u_title: *char = 0 as *char;
            var u_tlen: int = 0;
            var has_title: int = json_find_str(b_ptr, b_len, "title", 5, &u_title, &u_tlen);
            var u_desc: *char = 0 as *char;
            var u_dlen: int = 0;
            var has_desc: int = json_find_str(b_ptr, b_len, "description", 11, &u_desc, &u_dlen);
            var u_body: *char = 0 as *char;
            var u_blen: int = 0;
            var has_body: int = json_find_str(b_ptr, b_len, "body", 4, &u_body, &u_blen);

            var t_buf: [u8; 512] = uninit;
            var d_buf: [u8; 1024] = uninit;
            var p_title: *char = 0 as *char;
            if (has_title == 1) {
                if (u_tlen == 0 || u_tlen >= 512 || json_unescape(u_title, u_tlen, (&t_buf[0]) as *char, 512) < 0) {
                    return fmt_error_response(422, "title too long", out, cap);
                }
                p_title = (&t_buf[0]) as *char;
            }
            var p_desc: *char = 0 as *char;
            if (has_desc == 1) {
                if (u_dlen >= 1024 || json_unescape(u_desc, u_dlen, (&d_buf[0]) as *char, 1024) < 0) {
                    return fmt_error_response(422, "description too long", out, cap);
                }
                p_desc = (&d_buf[0]) as *char;
            }
            var p_b: *char = 0 as *char;
            if (has_body == 1) {
                var b_scratch: *char = get_scratch();
                if (u_blen >= 262144 || json_unescape(u_body, u_blen, b_scratch, 262144) < 0) {
                    return fmt_error_response(422, "body too long", out, cap);
                }
                p_b = b_scratch;
            }

            var p_upd: [*char; 4] = [(&slot->param2[0]) as *char, p_title, p_desc, p_b];
            var wconn: *PgConn = pg_get_write_conn_force();
            PQsendQueryPrepared(wconn->c, "s_article_update", 4, &p_upd[0], 0 as *int, 0 as *int, 0);
            var p_art: [*char; 2] = [v_str, (&slot->param2[0]) as *char];
            PQsendQueryPrepared(wconn->c, "s_article_by_id", 2, &p_art[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1;
        } else if (slot->step == 2) {
            if (slot->num_res < 2) {
                for (var ri: int = 0; ri < slot->num_res; ri = ri + 1) { PQclear(slot->res[ri]); slot->res[ri] = 0 as *void; }
                slot->num_res = 0;
                return fmt_error_response(500, "database update failed", out, cap);
            }
            var res_upd: *void = slot->res[0];
            var res_art: *void = slot->res[1];
            slot->res[0] = 0 as *void;
            slot->res[1] = 0 as *void;
            if (res_ok_tuples(res_upd) == 0 || PQntuples(res_upd) == 0 ||
                res_ok_tuples(res_art) == 0 || PQntuples(res_art) == 0) {
                PQclear(res_upd);
                PQclear(res_art);
                slot->num_res = 0;
                return fmt_error_response(500, "database update failed", out, cap);
            }
            var bw: BufWriter = uninit;
            bw.buf = ((out as i64) + 128 as i64) as *char;
            bw.len = 0;
            bw.cap = cap - 128;
            buf_append_str(&bw, "{\"article\":");
            render_article_object(&bw, res_art, 0, 1);
            buf_append_char(&bw, 125);
            PQclear(res_upd);
            PQclear(res_art);
            slot->num_res = 0;
            return finish_json_response(slot, 200, bw.len, out);
        }
    }

    if (slot->route_id == ROUTE_ARTICLE_DELETE) {
        if (slot->step == 1) {
            var res_own: *void = slot->res[0];
            if (PQresultStatus(res_own) != PGRES_TUPLES_OK || PQntuples(res_own) == 0) {
                PQclear(res_own);
                return fmt_error_response(404, "article not found", out, cap);
            }
            var aid_str: *char = PQgetvalue(res_own, 0, 0);
            var author_id_str: *char = PQgetvalue(res_own, 0, 1);
            var author_id: i64 = native_atoi(author_id_str) as i64;
            var aid_len: int = native_strlen(aid_str) as int;
            native_memcpy((&slot->param2[0]) as *char, aid_str, aid_len as i64);
            slot->param2[aid_len] = 0 as u8;
            PQclear(res_own);
            slot->num_res = 0;

            if (author_id != slot->viewer_id) {
                return fmt_error_response(403, "forbidden", out, cap);
            }

            var p_del: [*char; 1] = [(&slot->param2[0]) as *char];
            var wconn: *PgConn = pg_get_write_conn_force();
            PQsendQueryPrepared(wconn->c, "s_article_delete", 1, &p_del[0], 0 as *int, 0 as *int, 0);
            PQsendPipelineSync(wconn->c);
            pg_enqueue_slot(wconn, slot_idx);
            slot->step = 2;
            return -1;
        } else if (slot->step == 2) {
            var res_del: *void = slot->res[0];
            if (res_ok_command(res_del) == 0) {
                PQclear(res_del);
                slot->num_res = 0;
                return fmt_error_response(500, "database delete failed", out, cap);
            }
            PQclear(res_del);
            slot->num_res = 0;
            return fmt_204_response(out, cap);
        }
    }

    return fmt_error_response(404, "not found", out, cap);
}
