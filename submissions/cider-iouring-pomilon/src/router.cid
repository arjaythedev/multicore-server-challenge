// router.cid — Request router and JSON serializer for the 19 RealWorld Conduit endpoints
// Pure Cider non-blocking implementation with pipeline support.

from sys import native_memcpy, native_memset, native_memcmp, native_strlen, native_strncmp, native_itoa, native_atoi, sys_mmap, sys_read, sys_write, sys_exit, sys_getrandom;
from http import HttpRequest, http_query_param, http_parse_limit, http_parse_offset;
from json import json_find_str, json_find_taglist, json_escape, json_unescape, json_has_wrapper;
from sha256 import jwt_verify, jwt_sign;
from bcrypt import bcrypt_hash, bcrypt_verify;
from pg import PgConn, PQresultStatus, PQclear, PQntuples, PQnfields, PQgetvalue, PQgetisnull, pg_get_read_conn, pg_get_write_conn, pg_get_write_conn_force, pg_enqueue_slot, PQsendQueryPrepared, PQsendPipelineSync, PGRES_TUPLES_OK, PGRES_COMMAND_OK;

func str_len(s: *char) -> int {
    if (s as i64 == 0 as i64) { return 0; }
    return native_strlen(s) as int;
}

func res_ok_tuples(res: *void) -> int {
    if (res as i64 == 0 as i64) { return 0; }
    return (PQresultStatus(res) == PGRES_TUPLES_OK) as int;
}

func res_ok_command(res: *void) -> int {
    if (res as i64 == 0 as i64) { return 0; }
    return (PQresultStatus(res) == PGRES_COMMAND_OK) as int;
}

func gen_salt(salt: *u8) -> int {
    var total: int = 0;
    while (total < 16) {
        var n: i64 = sys_getrandom(((salt as i64) + (total as i64)) as *void, (16 - total) as i64, 0 as u32);
        if (n <= 0) { return 0; }
        total = total + (n as int);
    }
    return 1;
}

struct BufWriter {
    var buf: *char;
    var len: int;
    var cap: int;
}

func buf_append(w: *BufWriter, s: *char, len: int) -> void {
    if (w->len + len > w->cap) { return; }
    var base: i64 = w->buf as i64;
    native_memcpy((base + (w->len as i64)) as *char, s, len as i64);
    w->len = w->len + len;
}

func buf_append_str(w: *BufWriter, s: *char) -> void {
    buf_append(w, s, str_len(s));
}

func buf_append_char(w: *BufWriter, c: int) -> void {
    if (w->len + 1 > w->cap) { return; }
    var base: i64 = w->buf as i64;
    *(((base + (w->len as i64)) as *u8)) = c as u8;
    w->len = w->len + 1;
}

func buf_append_i64(w: *BufWriter, v: i64) -> void {
    var tmp: [u8; 32] = uninit;
    var n: int = native_itoa(v, (&tmp[0]) as *char);
    buf_append(w, (&tmp[0]) as *char, n);
}

func buf_append_json_str(w: *BufWriter, s: *char, len: int) -> void {
    buf_append_char(w, 34); // '"'
    if (len > 0 && s as i64 != 0 as i64) {
        var base: i64 = w->buf as i64;
        var rem: int = w->cap - w->len;
        if (rem > len * 2 + 2) {
            var n: int = json_escape(s, len, (base + (w->len as i64)) as *char);
            w->len = w->len + n;
        }
    }
    buf_append_char(w, 34); // '"'
}

func buf_append_json_nullable(w: *BufWriter, s: *char, is_null: int) -> void {
    if (is_null != 0 || s as i64 == 0 as i64) {
        buf_append_str(w, "null");
    } else {
        buf_append_json_str(w, s, str_len(s));
    }
}

func get_status_text(code: int) -> *char {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 422) { return "Unprocessable Entity"; }
    return "Internal Server Error";
}

func fmt_error_response(status_code: int, msg: *char, out: *char, cap: int) -> int {
    var body_buf: [u8; 256] = uninit;
    var bw: BufWriter = uninit;
    bw.buf = (&body_buf[0]) as *char;
    bw.len = 0;
    bw.cap = 256;
    buf_append_str(&bw, "{\"errors\":{\"body\":[");
    buf_append_json_str(&bw, msg, str_len(msg));
    buf_append_char(&bw, 93);  // ']'
    buf_append_char(&bw, 125); // '}'
    buf_append_char(&bw, 125); // '}'

    var w: BufWriter = uninit;
    w.buf = out;
    w.len = 0;
    w.cap = cap;

    buf_append_str(&w, "HTTP/1.1 ");
    buf_append_i64(&w, status_code as i64);
    buf_append_char(&w, 32);
    buf_append_str(&w, get_status_text(status_code));
    buf_append_str(&w, "\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: ");
    buf_append_i64(&w, bw.len as i64);
    buf_append_str(&w, "\r\nConnection: keep-alive\r\n\r\n");
    buf_append(&w, bw.buf, bw.len);
    return w.len;
}

func fmt_json_response(status_code: int, body: *char, blen: int, out: *char, cap: int) -> int {
    var w: BufWriter = uninit;
    w.buf = out;
    w.len = 0;
    w.cap = cap;

    buf_append_str(&w, "HTTP/1.1 ");
    buf_append_i64(&w, status_code as i64);
    buf_append_char(&w, 32);
    buf_append_str(&w, get_status_text(status_code));
    buf_append_str(&w, "\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: ");
    buf_append_i64(&w, blen as i64);
    buf_append_str(&w, "\r\nConnection: keep-alive\r\n\r\n");
    buf_append(&w, body, blen);
    return w.len;
}

func fmt_204_response(out: *char, cap: int) -> int {
    var w: BufWriter = uninit;
    w.buf = out;
    w.len = 0;
    w.cap = cap;
    buf_append_str(&w, "HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n");
    return w.len;
}

func render_user_json(w: *BufWriter, email: *char, token: *char, username: *char, bio: *char, bio_null: int, image: *char, image_null: int) -> void {
    buf_append_str(w, "{\"user\":{\"email\":");
    buf_append_json_str(w, email, str_len(email));
    buf_append_str(w, ",\"token\":");
    buf_append_json_str(w, token, str_len(token));
    buf_append_str(w, ",\"username\":");
    buf_append_json_str(w, username, str_len(username));
    buf_append_str(w, ",\"bio\":");
    buf_append_json_nullable(w, bio, bio_null);
    buf_append_str(w, ",\"image\":");
    buf_append_json_nullable(w, image, image_null);
    buf_append_char(w, 125); // '}'
    buf_append_char(w, 125); // '}'
}

func render_profile_json(w: *BufWriter, username: *char, bio: *char, bio_null: int, image: *char, image_null: int, following: int) -> void {
    buf_append_str(w, "{\"profile\":{\"username\":");
    buf_append_json_str(w, username, str_len(username));
    buf_append_str(w, ",\"bio\":");
    buf_append_json_nullable(w, bio, bio_null);
    buf_append_str(w, ",\"image\":");
    buf_append_json_nullable(w, image, image_null);
    buf_append_str(w, ",\"following\":");
    if (following != 0) {
        buf_append_str(w, "true");
    } else {
        buf_append_str(w, "false");
    }
    buf_append_char(w, 125); // '}'
    buf_append_char(w, 125); // '}'
}

func render_article_object(w: *BufWriter, res: *void, row: int, full: int) -> void {
    var slug: *char = PQgetvalue(res, row, 1);
    var title: *char = PQgetvalue(res, row, 2);
    var desc: *char = PQgetvalue(res, row, 3);
    var col: int = 4;
    var body: *char = 0 as *char;
    if (full != 0) {
        body = PQgetvalue(res, row, 4);
        col = 5;
    }
    var created_at: *char = PQgetvalue(res, row, col);
    var updated_at: *char = PQgetvalue(res, row, col + 1);
    var tag_list: *char = PQgetvalue(res, row, col + 2);
    var fav_count: *char = PQgetvalue(res, row, col + 3);
    var favorited_str: *char = PQgetvalue(res, row, col + 4);
    var username: *char = PQgetvalue(res, row, col + 5);
    var bio: *char = PQgetvalue(res, row, col + 6);
    var bio_null: int = PQgetisnull(res, row, col + 6);
    var image: *char = PQgetvalue(res, row, col + 7);
    var image_null: int = PQgetisnull(res, row, col + 7);
    var following_str: *char = PQgetvalue(res, row, col + 8);

    var fav: int = 0;
    if (*(((favorited_str as i64)) as *u8) == 116 as u8) { fav = 1; }
    var fol: int = 0;
    if (*(((following_str as i64)) as *u8) == 116 as u8) { fol = 1; }

    buf_append_str(w, "{\"slug\":");
    buf_append_json_str(w, slug, str_len(slug));
    buf_append_str(w, ",\"title\":");
    buf_append_json_str(w, title, str_len(title));
    buf_append_str(w, ",\"description\":");
    buf_append_json_str(w, desc, str_len(desc));
    if (full != 0) {
        buf_append_str(w, ",\"body\":");
        buf_append_json_str(w, body, str_len(body));
    }
    buf_append_str(w, ",\"tagList\":");
    buf_append_str(w, tag_list);
    buf_append_str(w, ",\"createdAt\":");
    buf_append_json_str(w, created_at, str_len(created_at));
    buf_append_str(w, ",\"updatedAt\":");
    buf_append_json_str(w, updated_at, str_len(updated_at));
    buf_append_str(w, ",\"favorited\":");
    if (fav != 0) { buf_append_str(w, "true"); } else { buf_append_str(w, "false"); }
    buf_append_str(w, ",\"favoritesCount\":");
    buf_append_str(w, fav_count);
    buf_append_str(w, ",\"author\":{\"username\":");
    buf_append_json_str(w, username, str_len(username));
    buf_append_str(w, ",\"bio\":");
    buf_append_json_nullable(w, bio, bio_null);
    buf_append_str(w, ",\"image\":");
    buf_append_json_nullable(w, image, image_null);
    buf_append_str(w, ",\"following\":");
    if (fol != 0) { buf_append_str(w, "true"); } else { buf_append_str(w, "false"); }
    buf_append_char(w, 125); // '}'
    buf_append_char(w, 125); // '}'
}

func render_comment_object(w: *BufWriter, res: *void, row: int, has_following: int) -> void {
    var id: *char = PQgetvalue(res, row, 0);
    var body: *char = PQgetvalue(res, row, 1);
    var created_at: *char = PQgetvalue(res, row, 2);
    var updated_at: *char = PQgetvalue(res, row, 3);
    var username: *char = PQgetvalue(res, row, 4);
    var bio: *char = PQgetvalue(res, row, 5);
    var bio_null: int = PQgetisnull(res, row, 5);
    var image: *char = PQgetvalue(res, row, 6);
    var image_null: int = PQgetisnull(res, row, 6);
    var fol: int = 0;
    if (has_following != 0) {
        var following_str: *char = PQgetvalue(res, row, 7);
        if (*(((following_str as i64)) as *u8) == 116 as u8) { fol = 1; }
    }

    buf_append_str(w, "{\"id\":");
    buf_append_str(w, id);
    buf_append_str(w, ",\"createdAt\":");
    buf_append_json_str(w, created_at, str_len(created_at));
    buf_append_str(w, ",\"updatedAt\":");
    buf_append_json_str(w, updated_at, str_len(updated_at));
    buf_append_str(w, ",\"body\":");
    buf_append_json_str(w, body, str_len(body));
    buf_append_str(w, ",\"author\":{\"username\":");
    buf_append_json_str(w, username, str_len(username));
    buf_append_str(w, ",\"bio\":");
    buf_append_json_nullable(w, bio, bio_null);
    buf_append_str(w, ",\"image\":");
    buf_append_json_nullable(w, image, image_null);
    buf_append_str(w, ",\"following\":");
    if (fol != 0) { buf_append_str(w, "true"); } else { buf_append_str(w, "false"); }
    buf_append_char(w, 125); // '}'
    buf_append_char(w, 125); // '}'
}

var g_scratch_ptr: i64 = 0;

func get_scratch() -> *char {
    if (g_scratch_ptr == 0 as i64) {
        var m: *void = sys_mmap(0 as *void, 262144, 3, 34, -1, 0); // 256KB
        g_scratch_ptr = m as i64;
    }
    return g_scratch_ptr as *char;
}

var STATE_IDLE: int = 0;
var STATE_RECV: int = 1;
var STATE_WAIT_DB: int = 2;
var STATE_SEND: int = 3;
var STATE_WAIT_PG: int = 4;
var STATE_WAIT_BCRYPT: int = 5;

struct BcryptJob {
    var slot_idx: int;
    var pw_len: int;
    var hash_len: int;
    var pw: [u8; 76];
    var hash: [u8; 68];
}

struct BcryptResp {
    var slot_idx: int;
    var ok: int;
}

var g_bcrypt_fds: [int; 4] = [-1, -1, -1, -1];
var g_bcrypt_load: [int; 4] = [0, 0, 0, 0];
var g_num_bcrypt: int = 0;
var g_bcrypt_turn: int = 0;

func router_set_bcrypt_fds(fds: *int, n: int) -> void {
    g_num_bcrypt = n;
    for (var i: int = 0; i < n; i = i + 1) {
        g_bcrypt_fds[i] = fds[i];
        g_bcrypt_load[i] = 0;
    }
}

func router_bcrypt_done(idx: int) -> void {
    if (idx >= 0 && idx < 4) {
        if (g_bcrypt_load[idx] > 0) {
            g_bcrypt_load[idx] = g_bcrypt_load[idx] - 1;
        }
    }
}

func bcrypt_worker_loop(fd: int) -> void {
    for (;;) {
        var job: BcryptJob = uninit;
        var nr: i64 = sys_read(fd, (&job) as *void, sizeof(BcryptJob) as i64);
        if (nr <= 0) {
            sys_exit(0);
        }
        var ok: int = bcrypt_verify((&job.pw[0]) as *char, job.pw_len, (&job.hash[0]) as *char, job.hash_len);
        var resp: BcryptResp = uninit;
        resp.slot_idx = job.slot_idx;
        resp.ok = ok;
        sys_write(fd, (&resp) as *void, sizeof(BcryptResp) as i64);
    }
}

var ROUTE_NONE: int = 0;
var ROUTE_TAGS: int = 1;
var ROUTE_USER_REGISTER: int = 2;
var ROUTE_USER_LOGIN: int = 3;
var ROUTE_USER_CURRENT: int = 4;
var ROUTE_USER_UPDATE: int = 5;
var ROUTE_PROFILE: int = 6;
var ROUTE_PROFILE_FOLLOW: int = 7;
var ROUTE_ARTICLES_LIST: int = 8;
var ROUTE_ARTICLES_FEED: int = 9;
var ROUTE_ARTICLE_GET: int = 10;
var ROUTE_ARTICLE_CREATE: int = 11;
var ROUTE_ARTICLE_UPDATE: int = 12;
var ROUTE_ARTICLE_DELETE: int = 13;
var ROUTE_ARTICLE_FAVORITE: int = 14;
var ROUTE_COMMENTS_GET: int = 15;
var ROUTE_COMMENTS_CREATE: int = 16;
var ROUTE_COMMENTS_DELETE: int = 17;

struct ConnSlot {
    var fd: int;
    var in_use: int;
    var state: int;
    var write_buf_idx: int;
    var write_offset: int;
    var write_len: int;
    var write_sent: int;

    // Route state
    var route_id: int;
    var sub_id: int;
    var step: int;
    var viewer_id: i64;
    var auth_status: int;

    // Results from PostgreSQL
    var num_res: int;
    var res: [*void; 4];

    // Saved data across DB round-trip
    var v_buf: [u8; 32];
    var lim_buf: [u8; 32];
    var off_buf: [u8; 32];
    var param1: [u8; 256];
    var param2: [u8; 256];
    var p1_len: int;
    var p2_len: int;

    // Socket read buffer
    var read_buf: [u8; 8192];
    var read_len: int;

    // In-flight coalescing link
    var next_coalesced: int;
}

var g_slots_base: i64 = 0;
var g_inflight_base: i64 = 0;

struct InFlightEntry {
    var in_use: int;
    var slot_idx: int;
    var viewer_id: i64;
    var hash: u32;
    var key_len: int;
    var key: [u8; 96];
}

func router_set_slots_base(ptr: *ConnSlot) -> void {
    g_slots_base = ptr as i64;
    var mem: *void = sys_mmap(0 as *void, 262144 as i64, 3, 34, -1, 0);
    g_inflight_base = mem as i64;
    var tbl: *InFlightEntry = mem as *InFlightEntry;
    for (var i: int = 0; i < 1024; i = i + 1) {
        tbl[i].in_use = 0;
    }
}

func finish_json_response(slot: *ConnSlot, status_code: int, body_len: int, out: *char) -> int {
    var hdr_tmp: [u8; 128] = uninit;
    var hw: BufWriter = uninit;
    hw.buf = (&hdr_tmp[0]) as *char;
    hw.len = 0;
    hw.cap = 128;
    buf_append_str(&hw, "HTTP/1.1 ");
    buf_append_i64(&hw, status_code as i64);
    buf_append_char(&hw, 32);
    buf_append_str(&hw, get_status_text(status_code));
    buf_append_str(&hw, "\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: ");
    buf_append_i64(&hw, body_len as i64);
    buf_append_str(&hw, "\r\nConnection: keep-alive\r\n\r\n");

    var hdr_len: int = hw.len;
    var offset: int = 128 - hdr_len;
    var dst: *char = ((out as i64) + (offset as i64)) as *char;
    native_memcpy(dst, hw.buf, hdr_len as i64);
    slot->write_offset = offset;
    return hdr_len + body_len;
}

func get_slot_by_idx(idx: int) -> *ConnSlot {
    var base: *ConnSlot = g_slots_base as *ConnSlot;
    return &base[idx];
}

func get_inflight_by_idx(idx: int) -> *InFlightEntry {
    var base: *InFlightEntry = g_inflight_base as *InFlightEntry;
    return &base[idx];
}

func str_fnv_hash(s: *char, len: int) -> u32 {
    var h: u32 = 2166136261 as u32;
    var base: i64 = s as i64;
    for (var i: int = 0; i < len; i = i + 1) {
        var c: u32 = (*((base + (i as i64)) as *u8)) as u32;
        h = (h ^ c) * (16777619 as u32);
    }
    return h;
}

func inflight_find(route_id: int, viewer_id: i64, key: *char, klen: int) -> int {
    if (klen > 90 || klen <= 0) { return -1; }
    var h: u32 = str_fnv_hash(key, klen) ^ (route_id as u32);
    var idx: int = (h & (1023 as u32)) as int;
    var e: *InFlightEntry = get_inflight_by_idx(idx);
    if (e->in_use != 0 && e->viewer_id == viewer_id && e->hash == h && e->key_len == klen) {
        if (native_strncmp((&e->key[0]) as *char, key, klen as i64) == 0) {
            return e->slot_idx;
        }
    }
    return -1;
}

func inflight_register(route_id: int, viewer_id: i64, key: *char, klen: int, slot_idx: int) -> void {
    if (klen > 90 || klen <= 0) { return; }
    var h: u32 = str_fnv_hash(key, klen) ^ (route_id as u32);
    var idx: int = (h & (1023 as u32)) as int;
    var e: *InFlightEntry = get_inflight_by_idx(idx);
    e->in_use = 1;
    e->slot_idx = slot_idx;
    e->viewer_id = viewer_id;
    e->hash = h;
    e->key_len = klen;
    native_memcpy((&e->key[0]) as *char, key, klen as i64);
}

func inflight_clear(route_id: int, key: *char, klen: int, slot_idx: int) -> void {
    if (klen > 90 || klen <= 0) { return; }
    var h: u32 = str_fnv_hash(key, klen) ^ (route_id as u32);
    var idx: int = (h & (1023 as u32)) as int;
    var e: *InFlightEntry = get_inflight_by_idx(idx);
    if (e->in_use != 0 && e->slot_idx == slot_idx) {
        e->in_use = 0;
    }
}

func router_clear_inflight(slot: *ConnSlot, slot_idx: int) -> void {
    // In-flight request coalescing was removed: every request reads its own data from PostgreSQL.
    slot->next_coalesced = -1;
}

func route_dispatch(slot: *ConnSlot, slot_idx: int, req: *HttpRequest, secret: *char, slen: int, out: *char, cap: int, out_len: *int) -> int {
    // 1. Authenticate
    slot->viewer_id = 0;
    slot->auth_status = 0; // 0 = no auth, 1 = valid auth, -1 = bad auth
    var incoming_token: *char = 0 as *char;
    var incoming_token_len: int = 0;
    var in_tok_buf: [u8; 512] = uninit;

    if (req->auth_len > 0) {
        if (req->auth_len > 6 && native_memcmp(req->auth_ptr, "Token ", 6) == 0) {
            incoming_token = (req->auth_ptr as i64 + 6) as *char;
            incoming_token_len = req->auth_len - 6;
            if (incoming_token_len > 0 && incoming_token_len < 512) {
                native_memcpy((&in_tok_buf[0]) as *char, incoming_token, incoming_token_len as i64);
                in_tok_buf[incoming_token_len] = 0 as u8;
                incoming_token = (&in_tok_buf[0]) as *char;
                if (jwt_verify(incoming_token, incoming_token_len, secret, slen, &slot->viewer_id) != 0) {
                    slot->auth_status = 1;
                } else {
                    slot->auth_status = -1;
                }
            } else {
                slot->auth_status = -1;
            }
        } else {
            slot->auth_status = -1;
        }
    }

    if (slot->auth_status < 0) {
        var is_public: int = 0;
        if (req->method == 1 && native_memcmp(req->path_ptr, "/api/tags", 9) == 0 && (req->path_len == 9 || *(((req->path_ptr as i64) + 9) as *u8) == 63 as u8)) {
            is_public = 1;
        } else if (req->method == 2 && req->path_len >= 10 && native_memcmp(req->path_ptr, "/api/users", 10) == 0) {
            is_public = 1;
        }
        if (is_public == 0) {
            *out_len = fmt_error_response(401, "unauthorized", out, cap);
            return 0; // Immediate
        }
    }

    native_itoa(slot->viewer_id, (&slot->v_buf[0]) as *char);
    var v_str: *char = (&slot->v_buf[0]) as *char;
    slot->num_res = 0;
    slot->step = 1;

    // Route: GET /api/tags
