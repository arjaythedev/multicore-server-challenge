# Selected submission settings, loaded and exported by start.sh.
# Selected HTTP/JSON/pool/password settings.
# Application + PostgreSQL share the external 8 CPU / 16 GiB budget.
# DATABASE_URL, JWT_SECRET, HOST and PORT remain caller configuration.
GOMAXPROCS=8
GOGC=200
GOMEMLIMIT=8GiB
DB_POOL_SIZE=24

HTTP_SERVER=compact
HTTP_CONTEXT_PARENT=server
HTTP_HOT_PATH=1
HTTP_API_READS=1
HTTP_RESPONSE_BUFFER=prefix
JSON_ENCODING=direct
JSON_DECODING=stream
JSON_QUOTING=vector

READ_BATCHING=1
READ_QUEUE_SIZE=32768
READ_BATCH_SIZE=2048
READ_WORKERS=6
READ_BATCH_WAIT_US=0
READ_WAIT_FILL=1
READ_SORT_IDS=1
READ_TAG_DICTIONARY=1
READ_EARLY_RELEASE=1
READ_STREAM_RELEASE=1
PROFILE_READ_BATCHING=1
USER_READ_BATCHING=0

WRITE_BATCHING=1
WRITE_WORKERS=4
WRITE_SLUG_LOOKUP=1

BCRYPT_BATCHING=1
BCRYPT_WORKERS=4
BCRYPT_BATCH_SIZE=5
BCRYPT_BATCH_WAIT_US=100000
