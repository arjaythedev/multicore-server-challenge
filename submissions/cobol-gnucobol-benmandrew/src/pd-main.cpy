*> ================= parent =================

MAIN-PARA.
    PERFORM INIT-HTTP-TABLES
    PERFORM INIT-JOUT-TABLES
    PERFORM INIT-JWT-TABLES
    PERFORM READ-CONFIG
    PERFORM BUILD-SQL
    CALL "signal" USING BY VALUE K-SIGPIPE BY VALUE K-SIG-IGN-D
    MOVE N-WORKERS TO NUM-ED
    MOVE N-PG TO NUM-ED2
    DISPLAY "conduit (cobol): " FUNCTION TRIM (NUM-ED) " workers x " FUNCTION TRIM (NUM-ED2)
        " Postgres connections"
    PERFORM VARYING W FROM 1 BY 1 UNTIL W > N-WORKERS
        CALL "socketpair" USING BY VALUE K-AF-UNIX BY VALUE K-SOCK-STREAM BY VALUE K-0
            BY REFERENCE PAIR-FDS RETURNING RC
        IF RC NOT = 0
            DISPLAY "socketpair failed" UPON SYSERR
            MOVE 1 TO RETURN-CODE
            STOP RUN
        END-IF
        MOVE PAIR-FD (1) TO BC-PAIR-FD (W, 1)
        MOVE PAIR-FD (2) TO BC-PAIR-FD (W, 2)
    END-PERFORM
    MOVE 0 TO N-CHILDREN
    PERFORM VARYING W FROM 1 BY 1 UNTIL W > N-WORKERS
        CALL "fork" RETURNING PID
        EVALUATE TRUE
            WHEN PID = 0
                *> keep only this worker's end of its own pair
                PERFORM VARYING J FROM 1 BY 1 UNTIL J > N-WORKERS
                    CALL "close" USING BY VALUE BC-PAIR-FD (J, 2)
                    IF J NOT = W
                        CALL "close" USING BY VALUE BC-PAIR-FD (J, 1)
                    END-IF
                END-PERFORM
                MOVE BC-PAIR-FD (W, 1) TO BC-FD
                COMPUTE WORKER-INDEX = W - 1
                PERFORM WORKER-MAIN
            WHEN PID < 0
                DISPLAY "fork failed" UPON SYSERR
                MOVE 1 TO RETURN-CODE
                STOP RUN
            WHEN OTHER
                ADD 1 TO N-CHILDREN
                MOVE PID TO CHILD-PID (N-CHILDREN)
        END-EVALUATE
    END-PERFORM
    CALL "fork" RETURNING PID
    IF PID = 0
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > N-WORKERS
            CALL "close" USING BY VALUE BC-PAIR-FD (J, 1)
        END-PERFORM
        PERFORM BC-MAIN
    END-IF
    ADD 1 TO N-CHILDREN
    MOVE PID TO CHILD-PID (N-CHILDREN)
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > N-WORKERS
        CALL "close" USING BY VALUE BC-PAIR-FD (J, 1)
        CALL "close" USING BY VALUE BC-PAIR-FD (J, 2)
    END-PERFORM
    *> If any child dies, take the rest down: a crash should be visible, not half a server.
    CALL "wait" USING BY REFERENCE WAIT-STATUS RETURNING PID
    MOVE PID TO NUM-ED
    DISPLAY "child pid " FUNCTION TRIM (NUM-ED) " exited; stopping" UPON SYSERR
    PERFORM VARYING W FROM 1 BY 1 UNTIL W > N-CHILDREN
        CALL "kill" USING BY VALUE CHILD-PID (W) BY VALUE K-SIGTERM
    END-PERFORM
    MOVE 1 TO RETURN-CODE
    STOP RUN.

READ-CONFIG.
    MOVE SPACES TO DB-URL
    ACCEPT DB-URL FROM ENVIRONMENT "DATABASE_URL"
    IF DB-URL = SPACES
        DISPLAY "DATABASE_URL is required" UPON SYSERR
        MOVE 2 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE SPACES TO JWT-SECRET
    ACCEPT JWT-SECRET FROM ENVIRONMENT "JWT_SECRET"
    IF JWT-SECRET = SPACES
        DISPLAY "JWT_SECRET is required" UPON SYSERR
        MOVE 2 TO RETURN-CODE
        STOP RUN
    END-IF
    *> ACCEPT pads with spaces; the secret ends at its last non-space byte.
    MOVE LENGTH OF JWT-SECRET TO JWT-SECRET-LEN
    PERFORM UNTIL JWT-SECRET-LEN = 0 OR JWT-SECRET (JWT-SECRET-LEN:1) NOT = SPACE
        SUBTRACT 1 FROM JWT-SECRET-LEN
    END-PERFORM
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "HOST"
    IF ENV-VAL = SPACES
        MOVE "127.0.0.1" TO LISTEN-HOST
    ELSE
        MOVE ENV-VAL TO LISTEN-HOST
    END-IF
    MOVE 3000 TO LISTEN-PORT
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "PORT"
    IF ENV-VAL NOT = SPACES
        COMPUTE LISTEN-PORT = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    MOVE 1 TO N-WORKERS
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "WORKERS"
    IF ENV-VAL NOT = SPACES
        COMPUTE N-WORKERS = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    IF N-WORKERS < 1 OR N-WORKERS > 256
        MOVE 1 TO N-WORKERS
    END-IF
    MOVE 2 TO N-PG
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "PG_CONNS"
    IF ENV-VAL NOT = SPACES
        COMPUTE N-PG = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    IF N-PG < 1 OR N-PG > MAX-PG
        MOVE 2 TO N-PG
    END-IF
    *> PG_MAX_SYNCS=<n>: the writer holds back while <n> Syncs are unanswered (0 = no limit).
    MOVE 2 TO MAX-SYNCS
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "PG_MAX_SYNCS"
    IF ENV-VAL NOT = SPACES
        COMPUTE MAX-SYNCS = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    *> PG_SESSION overrides the session settings.
    MOVE SPACES TO SESSION-SQL
    ACCEPT SESSION-SQL FROM ENVIRONMENT "PG_SESSION"
    IF SESSION-SQL = SPACES
        MOVE "SET jit = off; SET plan_cache_mode = force_generic_plan; SET enable_memoize = off"
            TO SESSION-SQL
    END-IF
    MOVE LENGTH OF SESSION-SQL TO SESSION-SQL-LEN
    PERFORM UNTIL SESSION-SQL-LEN = 0 OR SESSION-SQL (SESSION-SQL-LEN:1) NOT = SPACE
        SUBTRACT 1 FROM SESSION-SQL-LEN
    END-PERFORM
    MOVE 500 TO BC-WAIT-MS
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "BCRYPT_WAIT_MS"
    IF ENV-VAL NOT = SPACES
        COMPUTE BC-WAIT-MS = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    MOVE 3 TO BC-THREADS
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "BCRYPT_THREADS"
    IF ENV-VAL NOT = SPACES
        COMPUTE BC-THREADS = FUNCTION NUMVAL (ENV-VAL)
    END-IF
    IF BC-THREADS < 1 OR BC-THREADS > 64
        MOVE 3 TO BC-THREADS
    END-IF
    MOVE 10 TO BC-NICE
    MOVE SPACES TO ENV-VAL
    ACCEPT ENV-VAL FROM ENVIRONMENT "BCRYPT_NICE"
    IF ENV-VAL NOT = SPACES
        COMPUTE BC-NICE = FUNCTION NUMVAL (ENV-VAL)
    END-IF

    *> postgres://user:password@host:port/database
    MOVE SPACES TO URL-SCHEME URL-REST URL-USERINFO URL-HOSTPART URL-HOSTPORT
                   DB-USER DB-PASS DB-HOST DB-PORT-STR DB-NAME
    MOVE 0 TO DB-USER-LEN DB-PASS-LEN DB-HOST-LEN DB-NAME-LEN
    UNSTRING DB-URL DELIMITED BY "://" INTO URL-SCHEME URL-REST
    MOVE SPACES TO ENV-VAL
    UNSTRING URL-REST DELIMITED BY "?" OR SPACE INTO ENV-VAL
    MOVE ENV-VAL TO URL-REST
    *> the host part follows the last '@'
    MOVE FUNCTION LENGTH (FUNCTION TRIM (URL-REST TRAILING)) TO J
    PERFORM UNTIL J = 0 OR URL-REST (J:1) = "@"
        SUBTRACT 1 FROM J
    END-PERFORM
    IF J > 0
        MOVE URL-REST (1:J - 1) TO URL-USERINFO
        MOVE URL-REST (J + 1:) TO URL-HOSTPART
    ELSE
        MOVE URL-REST TO URL-HOSTPART
    END-IF
    UNSTRING URL-USERINFO DELIMITED BY ":" OR SPACE
        INTO DB-USER COUNT IN DB-USER-LEN DB-PASS COUNT IN DB-PASS-LEN
    UNSTRING URL-HOSTPART DELIMITED BY "/" OR SPACE
        INTO URL-HOSTPORT DB-NAME COUNT IN DB-NAME-LEN
    UNSTRING URL-HOSTPORT DELIMITED BY ":" OR SPACE
        INTO DB-HOST COUNT IN DB-HOST-LEN DB-PORT-STR
    IF DB-PORT-STR = SPACES
        MOVE 5432 TO DB-PORT
    ELSE
        COMPUTE DB-PORT = FUNCTION NUMVAL (DB-PORT-STR)
    END-IF
    MOVE DB-USER TO PCT-SRC
    MOVE DB-USER-LEN TO PCT-SRC-LEN
    PERFORM PCT-DECODE
    MOVE PCT-SRC TO DB-USER
    MOVE PCT-SRC-LEN TO DB-USER-LEN
    MOVE DB-PASS TO PCT-SRC
    MOVE DB-PASS-LEN TO PCT-SRC-LEN
    PERFORM PCT-DECODE
    MOVE PCT-SRC TO DB-PASS
    MOVE PCT-SRC-LEN TO DB-PASS-LEN
    IF DB-NAME-LEN = 0
        MOVE DB-USER TO DB-NAME
        MOVE DB-USER-LEN TO DB-NAME-LEN
    ELSE
        MOVE DB-NAME TO PCT-SRC
        MOVE DB-NAME-LEN TO PCT-SRC-LEN
        PERFORM PCT-DECODE
        MOVE PCT-SRC TO DB-NAME
        MOVE PCT-SRC-LEN TO DB-NAME-LEN
    END-IF
    IF DB-HOST-LEN = 0 OR DB-HOST (1:DB-HOST-LEN) = "localhost"
        MOVE "127.0.0.1" TO DB-HOST
        MOVE 9 TO DB-HOST-LEN
    END-IF
    MOVE SPACES TO DB-HOST-Z LISTEN-HOST-Z
    STRING DB-HOST (1:DB-HOST-LEN) X"00" DELIMITED BY SIZE INTO DB-HOST-Z
    STRING FUNCTION TRIM (LISTEN-HOST) X"00" DELIMITED BY SIZE INTO LISTEN-HOST-Z.

*> Percent-decodes PCT-SRC (1:PCT-SRC-LEN) in place: the URL's user, password and database.
PCT-DECODE.
    MOVE 1 TO PCT-I
    MOVE 0 TO PCT-O
    PERFORM UNTIL PCT-I > PCT-SRC-LEN
        ADD 1 TO PCT-O
        IF PCT-SRC (PCT-I:1) = "%" AND PCT-I + 2 <= PCT-SRC-LEN
            MOVE PCT-SRC (PCT-I + 1:1) TO BYTE-X
            MOVE PCT-SRC (PCT-I + 2:1) TO BYTE2-X
            COMPUTE L32 = HEX-VAL (BYTE-V + 1) * 16 + HEX-VAL (BYTE2-V + 1)
            MOVE L32-X (1:1) TO PCT-SRC (PCT-O:1)
            ADD 3 TO PCT-I
        ELSE
            MOVE PCT-SRC (PCT-I:1) TO PCT-SRC (PCT-O:1)
            ADD 1 TO PCT-I
        END-IF
    END-PERFORM
    MOVE PCT-O TO PCT-SRC-LEN.

*> NOW-MS: a monotonic clock in milliseconds, for timers.
GET-NOW-MS.
    CALL "clock_gettime" USING BY VALUE K-CLOCK-MONO BY REFERENCE TS
    COMPUTE NOW-MS = TS-SEC * 1000 + TS-NSEC / 1000000.
