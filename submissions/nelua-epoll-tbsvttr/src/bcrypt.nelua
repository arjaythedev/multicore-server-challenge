-- bcrypt as OpenBSD defines it ($2b$; $2a$ and $2y$ hashes of passwords up to 72 bytes are the same), for up to
-- BCRYPT_LANES passwords at once. Their Blowfish states are interleaved round by round, so one lane's S-box loads
-- overlap the others' instead of each waiting for its last: several hashes cost little more time than one.
-- (The interleaving is the idea of rust-epoll-theCatWisel.)
require 'blowfish'

## LANES = 6
global BCRYPT_LANES <comptime> = #[LANES]#

-- One hash to compute: the password (up to its first NUL, at most 72 bytes are used), the salt and cost; the
-- result is the digest (bcrypt's 23 bytes).
global BcryptJob = @record{
  password: [73]byte,
  password_len: int32,
  salt: [16]byte,
  cost: int32,
  digest: [23]byte
}

global Bcrypt = @record{}

local BfState = @record{p: [18]uint32, s: [1024]uint32}

local function F(s: *[1024]uint32, x: uint32): uint32 <inline>
  return ((s[x >> 24] + s[256 + ((x >> 16) & 0xff)]) ~ s[512 + ((x >> 8) & 0xff)]) + s[768 + (x & 0xff)]
end

-- The lanes' key words: a byte stream (cycled) read as 18 big-endian words.
local function stream_words(p: *[0]byte, n: int32, out: *[18]uint32): void
  local j: int32 = 0
  for i = 0, < 18 do
    local w: uint32 = 0
    for _ = 1, 4 do
      if j >= n then j = 0 end
      w = (w << 8) | p[j]
      j = j + 1
    end
    out[i] = w
  end
end

## for N = 1, LANES do
-- Encrypt each lane's block (l[k], r[k]) with its state.
local function #|'encipher' .. N|#(st: *[#[N]#]BfState, l: *[#[N]#]uint32, r: *[#[N]#]uint32): void <inline>
  ## for i = 0, 7 do
    ## for k = 0, N - 1 do
  l[#[k]#] = l[#[k]#] ~ st[#[k]#].p[#[2 * i]#]
  r[#[k]#] = r[#[k]#] ~ F(&st[#[k]#].s, l[#[k]#])
    ## end
    ## for k = 0, N - 1 do
  r[#[k]#] = r[#[k]#] ~ st[#[k]#].p[#[2 * i + 1]#]
  l[#[k]#] = l[#[k]#] ~ F(&st[#[k]#].s, r[#[k]#])
    ## end
  ## end
  ## for k = 0, N - 1 do
  do
    local t = l[#[k]#] ~ st[#[k]#].p[16]
    l[#[k]#] = r[#[k]#] ~ st[#[k]#].p[17]
    r[#[k]#] = t
  end
  ## end
end

  ## for _, SALTED in ipairs{true, false} do
-- Blowfish's key schedule step: P ^= the key's words, then P and the S-boxes replaced by the chained encryption
-- of zeros (the "salted" one also mixes the salt's words into each block first).
local function #|(SALTED and 'expand_salted' or 'expand') .. N|#(st: *[#[N]#]BfState, key: *[#[N]#][18]uint32,
                                                                 salt: *[#[N]#][4]uint32): void
    ## for k = 0, N - 1 do
  for i = 0, < 18 do st[#[k]#].p[i] = st[#[k]#].p[i] ~ key[#[k]#][i] end
    ## end
  local l: [#[N]#]uint32
  local r: [#[N]#]uint32
  local si: usize = 0
  for i: usize = 0, < 9 do
    ## if SALTED then
      ## for k = 0, N - 1 do
    l[#[k]#] = l[#[k]#] ~ salt[#[k]#][si & 3]
    r[#[k]#] = r[#[k]#] ~ salt[#[k]#][(si + 1) & 3]
      ## end
    si = si + 2
    ## end
    #|'encipher' .. N|#(st, &l, &r)
    ## for k = 0, N - 1 do
    st[#[k]#].p[2 * i] = l[#[k]#]
    st[#[k]#].p[2 * i + 1] = r[#[k]#]
    ## end
  end
  for i: usize = 0, < 512 do
    ## if SALTED then
      ## for k = 0, N - 1 do
    l[#[k]#] = l[#[k]#] ~ salt[#[k]#][si & 3]
    r[#[k]#] = r[#[k]#] ~ salt[#[k]#][(si + 1) & 3]
      ## end
    si = si + 2
    ## end
    #|'encipher' .. N|#(st, &l, &r)
    ## for k = 0, N - 1 do
    st[#[k]#].s[2 * i] = l[#[k]#]
    st[#[k]#].s[2 * i + 1] = r[#[k]#]
    ## end
  end
end
  ## end

-- bcrypt for N jobs of the same cost.
local function #|'bcrypt' .. N|#(jobs: *[0]BcryptJob, cost: int32): void
  local st: [#[N]#]BfState
  local key: [#[N]#][18]uint32
  local salt4: [#[N]#][4]uint32
  local salt18: [#[N]#][18]uint32
  for k = 0, < #[N]# do
    st[k].p = BF_P
    st[k].s = BF_S
    local job = &jobs[k]
    -- the password and its NUL, at most 72 bytes
    local n = job.password_len
    if n > 72 then n = 72 end
    job.password[n] = 0
    local key_len = n + 1
    if key_len > 72 then key_len = 72 end
    stream_words(&job.password, key_len, &key[k])
    stream_words(&job.salt, 16, &salt18[k])
    for i = 0, < 4 do salt4[k][i] = salt18[k][i] end
  end
  #|'expand_salted' .. N|#(&st, &key, &salt4)
  local rounds: uint64 = (@uint64)(1) << cost
  for _: uint64 = 1, rounds do
    #|'expand' .. N|#(&st, &key, &salt4)
    #|'expand' .. N|#(&st, &salt18, &salt4)
  end
  -- encrypt "OrpheanBeholderScryDoubt" 64 times
  local ctext: [#[N]#][6]uint32
  for k = 0, < #[N]# do
    ctext[k] = {0x4f727068, 0x65616e42, 0x65686f6c, 0x64657253, 0x63727944, 0x6f756274}
  end
  local l: [#[N]#]uint32
  local r: [#[N]#]uint32
  for _ = 1, 64 do
    for b = 0, < 3 do
      ## for k = 0, N - 1 do
      l[#[k]#] = ctext[#[k]#][2 * b]
      r[#[k]#] = ctext[#[k]#][2 * b + 1]
      ## end
      #|'encipher' .. N|#(&st, &l, &r)
      ## for k = 0, N - 1 do
      ctext[#[k]#][2 * b] = l[#[k]#]
      ctext[#[k]#][2 * b + 1] = r[#[k]#]
      ## end
    end
  end
  for k = 0, < #[N]# do
    for i = 0, < 23 do
      jobs[k].digest[i] = (@byte)((ctext[k][i // 4] >> (24 - 8 * (i % 4))) & 0xff)
    end
  end
end
## end

-- Compute jobs[0, n): BCRYPT_LANES at a time, each group as wide as it is.
function Bcrypt.run(jobs: *[0]BcryptJob, n: int32): void
  local i: int32 = 0
  while i < n do
    -- a group: the next jobs of the same cost, at most BCRYPT_LANES
    local cost = jobs[i].cost
    local m: int32 = 1
    while m < BCRYPT_LANES and i + m < n and jobs[i + m].cost == cost do m = m + 1 end
    local group = (@*[0]BcryptJob)(&jobs[i])
    ## for N = 1, LANES do
    if m == #[N]# then #|'bcrypt' .. N|#(group, cost) end
    ## end
    i = i + m
  end
end

local B64: string = './ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'

local function b64_value(c: byte): int32
  if c == '.'_b then return 0 end
  if c == '/'_b then return 1 end
  if c >= 'A'_b and c <= 'Z'_b then return c - 'A'_b + 2 end
  if c >= 'a'_b and c <= 'z'_b then return c - 'a'_b + 28 end
  if c >= '0'_b and c <= '9'_b then return c - '0'_b + 54 end
  return -1
end

-- bcrypt's base64 of p[0, n) (no padding) into out, which has room.
local function b64_encode(p: *[0]byte, n: int32, out: *[0]byte): int32
  local o: int32 = 0
  local i: int32 = 0
  while i < n do
    local c1: uint32 = p[i]
    out[o] = B64.data[c1 >> 2]
    o = o + 1
    c1 = (c1 & 0x03) << 4
    i = i + 1
    if i >= n then
      out[o] = B64.data[c1]
      return o + 1
    end
    local c2: uint32 = p[i]
    out[o] = B64.data[c1 | (c2 >> 4)]
    o = o + 1
    c1 = (c2 & 0x0f) << 2
    i = i + 1
    if i >= n then
      out[o] = B64.data[c1]
      return o + 1
    end
    c2 = p[i]
    out[o] = B64.data[c1 | (c2 >> 6)]
    out[o + 1] = B64.data[c2 & 0x3f]
    o = o + 2
    i = i + 1
  end
  return o
end

-- Decode s[0, chars) of bcrypt's base64 into out[0, n). False if a character isn't one of its alphabet.
local function b64_decode(s: *[0]byte, n: int32, out: *[0]byte): boolean
  local o: int32 = 0
  local i: int32 = 0
  while o < n do
    local c1 = b64_value(s[i])
    local c2 = b64_value(s[i + 1])
    if c1 < 0 or c2 < 0 then return false end
    out[o] = (@byte)((c1 << 2) | ((c2 & 0x30) >> 4))
    o = o + 1
    if o >= n then break end
    local c3 = b64_value(s[i + 2])
    if c3 < 0 then return false end
    out[o] = (@byte)(((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2))
    o = o + 1
    if o >= n then break end
    local c4 = b64_value(s[i + 3])
    if c4 < 0 then return false end
    out[o] = (@byte)(((c3 & 0x03) << 6) | c4)
    o = o + 1
    i = i + 4
  end
  return true
end

-- Read a stored hash ("$2a$", "$2b$" or "$2y$", a two-digit cost from 4 to 31, 22 characters of salt and 31 of
-- digest) into job's salt and cost, and its digest into digest. False if it isn't one.
function Bcrypt.parse(h: *[0]byte, n: isize, job: *BcryptJob, digest: *[23]byte): boolean
  if n ~= 60 or h[0] ~= '$'_b or h[1] ~= '2'_b or h[3] ~= '$'_b or h[6] ~= '$'_b then return false end
  if not (h[2] == 'a'_b or h[2] == 'b'_b or h[2] == 'y'_b) then return false end
  if h[4] < '0'_b or h[4] > '9'_b or h[5] < '0'_b or h[5] > '9'_b then return false end
  job.cost = (h[4] - '0'_b) * 10 + (h[5] - '0'_b)
  if job.cost < 4 or job.cost > 31 then return false end
  return b64_decode(&h[7], 16, &job.salt) and b64_decode(&h[29], 23, digest)
end

-- job's result as a stored hash, "$2b$<cost>$<salt><digest>": 60 bytes into out.
function Bcrypt.format(job: *BcryptJob, out: *[60]byte): void
  out[0], out[1], out[2], out[3] = '$'_b, '2'_b, 'b'_b, '$'_b
  out[4] = (@byte)('0'_b + job.cost // 10)
  out[5] = (@byte)('0'_b + job.cost % 10)
  out[6] = '$'_b
  b64_encode(&job.salt, 16, &out[7])
  b64_encode(&job.digest, 23, &out[29])
end
