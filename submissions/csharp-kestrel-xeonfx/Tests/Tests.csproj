<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit and property tests of passwords, JWT and query parsing. Run from this folder: dotnet test -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <!-- An independent bcrypt to check the server's hashes against. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <ProjectReference Include="../Conduit.csproj" />
  </ItemGroup>

</Project>
