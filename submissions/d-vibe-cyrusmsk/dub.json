{
    "name": "conduit-vibed",
    "description": "RealWorld Conduit API server in D on vibe.d (multicore server challenge)",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 cyrusmsk",
    "authors": ["cyrusmsk"],
    "targetType": "executable",
    "targetPath": "bin",
    "sourcePaths": ["source"],
    "dependencies": {
        "vibe-core-light": "~>0.2.5",
        "vibe-http-light": "~>0.2.2",
        "vibe-serialization": "~>1.0.0",
        "dpq2": "~>1.3.1",
        "photon": "~>0.18.8",
        "passwd": "~>0.3.0",
        "jwtlited:openssl": "~>1.4.0",
        "openssl": "~>3.4.0",
        "vibe-stream-light:tls": "~>0.2.0"
    },
    "dflags": ["-mcpu=native"],
    "dflags-ldc": ["-flto=full"],
    "libs": ["ssl", "crypto"],
    "versions": [
      "VibeManualMemoryManagement",
      "VibeHighEventPriority",
      "VibeDisableCommandLineParsing"
    ],
    "subConfigurations": {
        "vibe-stream-light:tls": "notls",
    },
    "lflags-osx": ["-L/opt/homebrew/opt/libpq/lib", "-L/opt/homebrew/opt/openssl@3/lib"]
}
