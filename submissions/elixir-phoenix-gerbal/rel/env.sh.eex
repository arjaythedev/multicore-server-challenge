#!/bin/sh

# A single node: no Erlang distribution, so no epmd either.
export RELEASE_DISTRIBUTION=none
export LANG=C.UTF-8

case $RELEASE_COMMAND in
  start*|daemon*)
    # Normal schedulers on 5/8 of the cores (5 of 8 on the box): Postgres burns most of the rest, and extra runnable
    # scheduler threads only preempt it. At real pacing on 8 threads (37,000 users, interleaved) +S 5:5 took app CPU
    # per request 0.476 -> 0.458 ms and p95 360 -> 290 ms. Flags already in ERL_AFLAGS come later and win.
    cores=$(nproc)
    schedulers=$(( (cores * 5 + 4) / 8 ))
    [ "$schedulers" -ge 2 ] || schedulers=2
    export ERL_AFLAGS="+S $schedulers:$schedulers ${ERL_AFLAGS:-}"
    ;;
esac
