CWD := justfile_directory()
SUBMISSIONS_DIR := parent_directory(CWD)
REPO_ROOT := parent_directory(SUBMISSIONS_DIR)

# list just commands
default:
  @just --list

# test submission (needs go,psql and curl)
test:
  @cd {{REPO_ROOT}} && bash test/run.sh submissions/python-rawsocket-shawal-mbalire

# show paths  resolution
paths:
  @echo {{ CWD }}
  @echo {{ SUBMISSIONS_DIR }}
  @echo {{ REPO_ROOT }}

# create or recreate the local virtualenv with pinned deps (the same build.sh the box runs)
venv:
  bash build.sh

# lint: compile-check all sources (syntax) — fast static gate
lint:
  .venv/bin/python -m py_compile $(find conduit_server -name '*.py') && echo LINT_OK

# check: lint + import wiring (composition root imports cleanly, routes registered)
check: lint
  .venv/bin/python scripts/check.py
