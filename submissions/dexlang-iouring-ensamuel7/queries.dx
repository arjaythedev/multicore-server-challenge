import "github.com/ensamuel7/dex-modules/dexqu" as "q"

const PG: q.Dialect = q.Dialect.Postgres

fn cols(names: string[]): q.Expr[] {
    let out: q.Expr[] = []
    foreach (names as name) {
        out.push(q.col(name))
    }
    return out
}

fn append(a: q.Expr[], b: q.Expr[]): q.Expr[] {
    let out: q.Expr[] = []
    foreach (a as e) {
        out.push(e)
    }
    foreach (b as e) {
        out.push(e)
    }
    return out
}

fn noArgs(): q.Expr[] {
    let none: q.Expr[] = []
    return none
}

fn one(): q.Expr {
    return q.raw("1")
}

fn tagList(): q.Expr {
    let name: q.Select = q.from("tags t").columns(["t.name"]).where(q.col("t.id").eq(q.col("at.tag_id")))
    return q.arrayOf(q.from("article_tags at").select([q.sub(name)]).where(q.col("at.article_id").eq(q.col("a.id"))).orderByExpr(one())).alias("tag_list")
}

fn favoritesCount(): q.Expr {
    return q.sub(q.from("favorites f").select([q.countAll()]).where(q.col("f.article_id").eq(q.col("a.id")))).alias("favorites_count")
}

fn favoritedBy(article: q.Expr, v: q.Expr): q.Expr {
    return q.exists(q.from("favorites f").select([one()]).where(q.col("f.article_id").eq(article)).where(q.col("f.user_id").eq(v)))
}

fn follows(v: q.Expr, author: q.Expr): q.Expr {
    return q.exists(q.from("follows fo").select([one()]).where(q.col("fo.follower_id").eq(v)).where(q.col("fo.followee_id").eq(author)))
}

fn viewerColumns(v: q.Expr): q.Expr[] {
    return [favoritesCount(), favoritedBy(q.col("a.id"), v).alias("favorited"), q.col("u.username"), q.col("u.bio"), q.col("u.image"), follows(v, q.col("a.author_id")).alias("following")]
}

fn fullSelect(v: q.Expr): q.Select {
    let head: q.Expr[] = cols(["a.id", "a.slug", "a.title", "a.description", "a.body", "a.created_at", "a.updated_at"])
    head.push(tagList())
    return q.from("articles a").select(append(head, viewerColumns(v))).join("users u", q.col("u.id").eq(q.col("a.author_id")))
}

fn withCount(count: q.Select, list: q.Select): q.Select {
    return q.select(cols(["n.total", "l.*"])).fromExpr(q.sub(count).aliasColumns("n", ["total"])).leftJoinLateral(q.sub(list).alias("l"), q.boolean(true)).orderByExpr(q.col("l.id").desc())
}

fn listPage(ids: q.Select, v: q.Expr): q.Select {
    let head: q.Expr[] = cols(["a.id", "a.slug", "a.title", "a.description", "a.created_at", "a.updated_at"])
    head.push(tagList())
    return q.select(append(head, viewerColumns(v))).fromExpr(q.sub(ids).alias("p")).join("articles a", q.col("a.id").eq(q.col("p.id"))).join("users u", q.col("u.id").eq(q.col("a.author_id"))).orderByExpr(q.col("a.id").desc())
}

fn capped(rows: q.Select): q.Select {
    return q.select([q.countAll()]).fromExpr(q.sub(rows.select([one()]).limitExpr(q.raw("1000"))).alias("s"))
}

fn tagId(k: q.Expr): q.Expr {
    return q.sub(q.from("tags t").columns(["t.id"]).where(q.col("t.name").eq(k)))
}

fn userId(alias: string, k: q.Expr): q.Expr {
    return q.sub(q.from("users " + alias).columns([alias + ".id"]).where(q.col(alias + ".username").eq(k)))
}

fn countAll(): q.Select {
    return capped(q.from("articles a"))
}

fn idsAll(l: q.Expr, o: q.Expr): q.Select {
    return q.from("articles").columns(["id"]).orderByExpr(q.col("id").desc()).limitExpr(l).offsetExpr(o)
}

fn countTag(k: q.Expr): q.Select {
    return capped(q.from("article_tags at").where(q.col("at.tag_id").eq(tagId(k))))
}

fn idsTag(k: q.Expr, l: q.Expr, o: q.Expr): q.Select {
    return q.from("article_tags at").select([q.col("at.article_id").alias("id")]).where(q.col("at.tag_id").eq(tagId(k))).orderByExpr(q.col("at.article_id").desc()).limitExpr(l).offsetExpr(o)
}

fn countAuthor(k: q.Expr): q.Select {
    return capped(q.from("articles a").where(q.col("a.author_id").eq(userId("u", k))))
}

fn idsAuthor(k: q.Expr, l: q.Expr, o: q.Expr): q.Select {
    return q.from("articles").columns(["id"]).where(q.col("author_id").eq(userId("au", k))).orderByExpr(q.col("id").desc()).limitExpr(l).offsetExpr(o)
}

fn countFavorited(k: q.Expr): q.Select {
    return capped(q.from("favorites f").where(q.col("f.user_id").eq(userId("fu", k))))
}

fn idsFavorited(k: q.Expr, l: q.Expr, o: q.Expr): q.Select {
    return q.from("favorites f").select([q.col("f.article_id").alias("id")]).where(q.col("f.user_id").eq(userId("fu", k))).orderByExpr(q.col("f.article_id").desc()).limitExpr(l).offsetExpr(o)
}

fn followees(v: q.Expr): q.Select {
    return q.from("follows fo").columns(["fo.followee_id"]).where(q.col("fo.follower_id").eq(v))
}

fn countFeed(v: q.Expr): q.Select {
    return capped(q.from("articles a").where(q.col("a.author_id").inSelect(followees(v))))
}

fn idsFeed(v: q.Expr, l: q.Expr, o: q.Expr): q.Select {
    let newest: q.Select = q.from("articles a2").columns(["a2.id"]).where(q.col("a2.author_id").eq(q.col("fo.followee_id"))).orderByExpr(q.col("a2.id").desc()).limitExpr(l.cast("int").plus(o.cast("int")))
    return q.select([q.col("x.id")]).from("follows fo").crossJoinLateral(q.sub(newest).alias("x")).where(q.col("fo.follower_id").eq(v)).orderByExpr(q.col("x.id").desc()).limitExpr(l).offsetExpr(o)
}

fn profileOf(v: q.Expr, k: q.Expr): q.Select {
    return q.from("users u").select(append(cols(["u.id", "u.username", "u.bio", "u.image"]), [follows(v, q.col("u.id")).alias("following")])).where(q.col("u.username").eq(k))
}

fn userOf(v: q.Expr): q.Select {
    return q.from("users").columns(["id", "username", "email", "bio", "image"]).where(q.col("id").eq(v))
}

fn commentsOf(v: q.Expr, k: q.Expr): q.Select {
    let newest: q.Select = q.from("comments c").select(append(cols(["c.id", "c.body", "c.created_at", "c.updated_at", "u.username", "u.bio", "u.image"]), [follows(v, q.col("c.author_id")).alias("following")])).join("users u", q.col("u.id").eq(q.col("c.author_id"))).where(q.col("c.article_id").eq(q.col("a.id"))).orderByExpr(q.col("c.created_at").desc()).orderByExpr(q.col("c.id").desc()).limitExpr(q.raw("100"))
    let picked: q.Expr[] = [q.col("a.id").alias("article_id")]
    return q.from("articles a").select(append(picked, cols(["c.id", "c.body", "c.created_at", "c.updated_at", "c.username", "c.bio", "c.image", "c.following"]))).leftJoinLateral(q.sub(newest).alias("c"), q.boolean(true)).where(q.col("a.slug").eq(k)).orderByExpr(q.col("c.created_at").desc()).orderByExpr(q.col("c.id").desc())
}

fn requests(): q.Expr {
    return q.call("unnest", [q.param("ids").cast("int4[]"), q.param("viewers").cast("int8[]"), q.param("limits").cast("int4[]"), q.param("offsets").cast("int4[]"), q.param("keys").cast("text[]")]).aliasColumns("r", ["i", "v", "l", "o", "k"])
}

fn batched(query: q.Select, order: q.Expr[]): q.Query throws q.QueryError {
    let s: q.Select = q.select(cols(["r.i", "x.*"])).fromExpr(requests()).crossJoinLateral(q.sub(query).alias("x")).orderBy("r.i")
    foreach (order as e) {
        s = s.orderByExpr(e)
    }
    return s.build(PG)
}

fn sharedList(key: string, count: q.Select, ids: q.Select): q.Query throws q.QueryError {
    let distinctKeys: q.Select = q.from("r").distinct().select([q.col(key).alias("key")])
    let counts: q.Select = q.select([q.col("d.key"), q.sub(count).alias("total")]).fromExpr(q.sub(distinctKeys).alias("d"))
    let pages: q.Select = q.from("r").distinct().select([q.col(key).alias("key"), q.col("l"), q.col("o")])
    let pageIds: q.Select = q.select(cols(["g.key", "g.l", "g.o", "q.id"])).from("g").crossJoinLateral(q.sub(ids).alias("q"))
    let article: q.Select = q.from("articles ar").where(q.col("ar.id").eq(q.col("d.id"))).limitExpr(one())
    let author: q.Select = q.from("users us").columns(["us.username", "us.bio", "us.image"]).where(q.col("us.id").eq(q.col("a.author_id"))).limitExpr(one())
    let head: q.Expr[] = cols(["a.id", "a.author_id", "a.slug", "a.title", "a.description", "a.created_at", "a.updated_at"])
    head.push(tagList())
    head.push(favoritesCount())
    let decorated: q.Select = q.select(append(head, cols(["u.username", "u.bio", "u.image"]))).fromExpr(q.sub(q.from("p").distinct().columns(["id"])).alias("d")).crossJoinLateral(q.sub(article).alias("a")).crossJoinLateral(q.sub(author).alias("u"))
    let present: q.Expr = q.col("x.id").isNotNull()
    let picked: q.Expr[] = cols(["r.i", "c.total", "x.id", "x.slug", "x.title", "x.description", "x.created_at", "x.updated_at", "x.tag_list", "x.favorites_count"])
    picked.push(q.caseWhen(present, favoritedBy(q.col("x.id"), q.col("r.v"))).end().alias("favorited"))
    picked = append(picked, cols(["x.username", "x.bio", "x.image"]))
    picked.push(q.caseWhen(present, follows(q.col("r.v"), q.col("x.author_id"))).end().alias("following"))
    let rk: q.Expr = q.col("r." + key)
    let s: q.Select = q.from("r").select(picked)
        .withMaterialized("r", q.select([q.star()]).fromExpr(requests()))
        .withMaterialized("c", counts)
        .withMaterialized("g", pages)
        .withMaterialized("p", pageIds)
        .withMaterialized("x", decorated)
        .join("c", q.col("c.key").eq(rk))
        .leftJoin("p", q.and([q.col("p.key").eq(rk), q.col("p.l").eq(q.col("r.l")), q.col("p.o").eq(q.col("r.o"))]))
        .leftJoin("x", q.col("x.id").eq(q.col("p.id")))
        .orderBy("r.i")
        .orderByExpr(q.col("x.id").desc())
    return s.build(PG)
}

fn slugOf(title: q.Expr): q.Expr {
    return q.rawWith("trim(both '-' from lower(regexp_replace(?, '[^A-Za-z0-9]+', '-', 'g')))", [title])
}

fn tags(): q.Query throws q.QueryError {
    return q.from("tags").columns(["name"]).orderBy("name").build(PG)
}

fn insertUser(): q.Query throws q.QueryError {
    return q.insertInto("users").columns(["username", "email", "password_hash"]).values([q.param("username"), q.param("email"), q.param("hash")]).returning(["id", "username", "email", "bio", "image"]).build(PG)
}

fn login(): q.Query throws q.QueryError {
    return q.from("users").columns(["id", "username", "email", "bio", "image", "password_hash"]).where(q.col("email").eq(q.param("email"))).build(PG)
}

fn userById(): q.Query throws q.QueryError {
    return userOf(q.param("viewer")).build(PG)
}

fn keep(column: string): q.Expr {
    return q.coalesce([q.param(column), q.col(column)])
}

fn updateUser(): q.Query throws q.QueryError {
    return q.update("users")
        .set("email", keep("email"))
        .set("username", keep("username"))
        .set("password_hash", q.coalesce([q.param("hash"), q.col("password_hash")]))
        .set("bio", keep("bio"))
        .set("image", keep("image"))
        .where(q.col("id").eq(q.param("id")))
        .returning(["id", "username", "email", "bio", "image"])
        .build(PG)
}

fn profile(): q.Query throws q.QueryError {
    return profileOf(q.param("viewer"), q.param("key")).build(PG)
}

fn userByName(): q.Query throws q.QueryError {
    return q.from("users").columns(["id", "username", "bio", "image"]).where(q.col("username").eq(q.param("username"))).build(PG)
}

fn follow(): q.Query throws q.QueryError {
    return q.insertInto("follows").columns(["follower_id", "followee_id"]).values([q.param("follower"), q.param("followee")]).doNothing().build(PG)
}

fn unfollow(): q.Query throws q.QueryError {
    return q.deleteFrom("follows").where(q.col("follower_id").eq(q.param("follower"))).where(q.col("followee_id").eq(q.param("followee"))).build(PG)
}

fn listAll(): q.Query throws q.QueryError {
    return withCount(countAll(), listPage(idsAll(q.param("limit"), q.param("offset")), q.param("viewer"))).build(PG)
}

fn listByTag(): q.Query throws q.QueryError {
    return withCount(countTag(q.param("key")), listPage(idsTag(q.param("key"), q.param("limit"), q.param("offset")), q.param("viewer"))).build(PG)
}

fn listByAuthor(): q.Query throws q.QueryError {
    return withCount(countAuthor(q.param("key")), listPage(idsAuthor(q.param("key"), q.param("limit"), q.param("offset")), q.param("viewer"))).build(PG)
}

fn listByFavorited(): q.Query throws q.QueryError {
    return withCount(countFavorited(q.param("key")), listPage(idsFavorited(q.param("key"), q.param("limit"), q.param("offset")), q.param("viewer"))).build(PG)
}

fn listFeed(): q.Query throws q.QueryError {
    return withCount(countFeed(q.param("viewer")), listPage(idsFeed(q.param("viewer"), q.param("limit"), q.param("offset")), q.param("viewer"))).build(PG)
}

fn articleBySlug(): q.Query throws q.QueryError {
    return fullSelect(q.param("viewer")).where(q.col("a.slug").eq(q.param("key"))).build(PG)
}

fn articleById(): q.Query throws q.QueryError {
    return fullSelect(q.param("viewer")).where(q.col("a.id").eq(q.param("id"))).build(PG)
}

fn insertArticle(): q.Query throws q.QueryError {
    let next: q.Select = q.select([q.raw("nextval(pg_get_serial_sequence('articles', 'id'))").alias("id")])
    let row: q.Select = q.select([q.col("n.id"), slugOf(q.param("title")).concat(q.raw("'-'")).concat(q.col("n.id")), q.param("author"), q.param("title"), q.param("description"), q.param("body")]).fromExpr(q.sub(next).alias("n"))
    return q.insertInto("articles").columns(["id", "slug", "author_id", "title", "description", "body"]).fromSelect(row).returning(["id"]).build(PG)
}

fn insertTags(): q.Query throws q.QueryError {
    return q.insertInto("tags").columns(["name"]).fromSelect(q.select([q.call("unnest", [q.param("names").cast("text[]")])]).distinct()).onConflict(["name"]).doNothing().build(PG)
}

fn insertArticleTags(): q.Query throws q.QueryError {
    let row: q.Select = q.from("tags t").select([q.param("article"), q.col("t.id")]).where(q.col("t.name").eq(q.call("ANY", [q.param("names").cast("text[]")])))
    return q.insertInto("article_tags").columns(["article_id", "tag_id"]).fromSelect(row).build(PG)
}

fn ownArticle(): q.Query throws q.QueryError {
    return q.from("articles").columns(["id", "author_id"]).where(q.col("slug").eq(q.param("slug"))).build(PG)
}

fn updateArticle(): q.Query throws q.QueryError {
    let slug: q.Expr = q.caseWhen(q.param("title").cast("text").isNull(), q.col("slug")).orElse(slugOf(q.param("title")).concat(q.raw("'-'")).concat(q.col("id")))
    return q.update("articles")
        .set("title", keep("title"))
        .set("description", keep("description"))
        .set("body", keep("body"))
        .set("slug", slug)
        .set("updated_at", q.call("now", noArgs()))
        .where(q.col("id").eq(q.param("id")))
        .build(PG)
}

fn deleteArticle(): q.Query throws q.QueryError {
    return q.deleteFrom("articles").where(q.col("id").eq(q.param("id"))).build(PG)
}

fn articleId(): q.Query throws q.QueryError {
    return q.from("articles").columns(["id"]).where(q.col("slug").eq(q.param("slug"))).build(PG)
}

fn favorite(): q.Query throws q.QueryError {
    return q.insertInto("favorites").columns(["user_id", "article_id"]).values([q.param("user"), q.param("article")]).doNothing().build(PG)
}

fn unfavorite(): q.Query throws q.QueryError {
    return q.deleteFrom("favorites").where(q.col("user_id").eq(q.param("user"))).where(q.col("article_id").eq(q.param("article"))).build(PG)
}

fn comments(): q.Query throws q.QueryError {
    return commentsOf(q.param("viewer"), q.param("key")).build(PG)
}

fn authorColumn(column: string): q.Expr {
    return q.sub(q.from("users u").columns(["u." + column]).where(q.col("u.id").eq(q.col("comments.author_id")))).alias(column)
}

fn insertComment(): q.Query throws q.QueryError {
    return q.insertInto("comments").columns(["article_id", "author_id", "body"]).values([q.param("article"), q.param("author"), q.param("body")]).returning(["id", "body", "created_at", "updated_at"]).returningExpr([authorColumn("username"), authorColumn("bio"), authorColumn("image")]).build(PG)
}

fn commentAuthor(): q.Query throws q.QueryError {
    return q.from("comments c").columns(["c.author_id"]).join("articles a", q.col("a.id").eq(q.col("c.article_id"))).where(q.col("c.id").eq(q.param("id"))).where(q.col("a.slug").eq(q.param("slug"))).build(PG)
}

fn deleteComment(): q.Query throws q.QueryError {
    return q.deleteFrom("comments").where(q.col("id").eq(q.param("id"))).build(PG)
}

fn batchUser(): q.Query throws q.QueryError {
    let none: q.Expr[] = []
    return batched(userOf(q.col("r.v")), none)
}

fn batchProfile(): q.Query throws q.QueryError {
    let none: q.Expr[] = []
    return batched(profileOf(q.col("r.v"), q.col("r.k")), none)
}

fn batchArticle(): q.Query throws q.QueryError {
    let none: q.Expr[] = []
    return batched(fullSelect(q.col("r.v")).where(q.col("a.slug").eq(q.col("r.k"))), none)
}

fn batchComments(): q.Query throws q.QueryError {
    return batched(commentsOf(q.col("r.v"), q.col("r.k")), [q.col("x.created_at").desc(), q.col("x.id").desc()])
}

fn batchListAll(): q.Query throws q.QueryError {
    return sharedList("k", countAll(), idsAll(q.col("g.l"), q.col("g.o")))
}

fn batchListTag(): q.Query throws q.QueryError {
    return sharedList("k", countTag(q.col("d.key")), idsTag(q.col("g.key"), q.col("g.l"), q.col("g.o")))
}

fn batchListAuthor(): q.Query throws q.QueryError {
    return sharedList("k", countAuthor(q.col("d.key")), idsAuthor(q.col("g.key"), q.col("g.l"), q.col("g.o")))
}

fn batchListFavorited(): q.Query throws q.QueryError {
    return sharedList("k", countFavorited(q.col("d.key")), idsFavorited(q.col("g.key"), q.col("g.l"), q.col("g.o")))
}

fn batchListFeed(): q.Query throws q.QueryError {
    return sharedList("v", countFeed(q.col("d.key")), idsFeed(q.col("g.key"), q.col("g.l"), q.col("g.o")))
}
