const TAG_LIST: string = "ARRAY(SELECT (SELECT t.name FROM tags t WHERE t.id = at.tag_id) FROM article_tags at WHERE at.article_id = a.id ORDER BY 1) AS tag_list"

const VIEWER_COLUMNS: string = "(SELECT count(*) FROM favorites f WHERE f.article_id = a.id) AS favorites_count, EXISTS (SELECT 1 FROM favorites f WHERE f.article_id = a.id AND f.user_id = $1) AS favorited, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = $1 AND fo.followee_id = a.author_id) AS following"

const FULL_SELECT: string = "SELECT a.id, a.slug, a.title, a.description, a.body, a.created_at, a.updated_at, " + TAG_LIST + ", " + VIEWER_COLUMNS + " FROM articles a JOIN users u ON u.id = a.author_id"

fn withCount(count: string, list: string): string {
    return "SELECT n.total, l.* FROM (" + count + ") n(total) LEFT JOIN LATERAL (" + list + ") l ON true ORDER BY l.id DESC"
}

fn listPage(ids: string): string {
    return "SELECT a.id, a.slug, a.title, a.description, a.created_at, a.updated_at, " + TAG_LIST + ", " + VIEWER_COLUMNS + " FROM (" + ids + ") p JOIN articles a ON a.id = p.id JOIN users u ON u.id = a.author_id ORDER BY a.id DESC"
}

const SLUGIFY: string = "trim(both '-' from lower(regexp_replace($2, '[^A-Za-z0-9]+', '-', 'g')))"

fn tags(): string {
    return "SELECT name FROM tags ORDER BY name"
}

fn insertUser(): string {
    return "INSERT INTO users (username, email, password_hash) VALUES ($1, $2, $3) RETURNING id, username, email, bio, image"
}

fn login(): string {
    return "SELECT id, username, email, bio, image, password_hash FROM users WHERE email = $1"
}

fn userById(): string {
    return "SELECT id, username, email, bio, image FROM users WHERE id = $1"
}

fn updateUser(): string {
    return "UPDATE users SET email = COALESCE($2, email), username = COALESCE($3, username), password_hash = COALESCE($4, password_hash), bio = COALESCE($5, bio), image = COALESCE($6, image) WHERE id = $1 RETURNING id, username, email, bio, image"
}

fn profile(): string {
    return "SELECT u.id, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = $1 AND fo.followee_id = u.id) AS following FROM users u WHERE u.username = $2"
}

fn userByName(): string {
    return "SELECT id, username, bio, image FROM users WHERE username = $1"
}

fn follow(): string {
    return "INSERT INTO follows (follower_id, followee_id) VALUES ($1, $2) ON CONFLICT DO NOTHING"
}

fn unfollow(): string {
    return "DELETE FROM follows WHERE follower_id = $1 AND followee_id = $2"
}

fn listAll(): string {
    return withCount("SELECT count(*) FROM (SELECT 1 FROM articles a LIMIT 1000) s", listPage("SELECT id FROM articles ORDER BY id DESC LIMIT $2 OFFSET $3"))
}

fn listByTag(): string {
    return withCount("SELECT count(*) FROM (SELECT 1 FROM article_tags at WHERE at.tag_id = (SELECT t.id FROM tags t WHERE t.name = $4) LIMIT 1000) s", listPage("SELECT at.article_id AS id FROM article_tags at WHERE at.tag_id = (SELECT t.id FROM tags t WHERE t.name = $4) ORDER BY at.article_id DESC LIMIT $2 OFFSET $3"))
}

fn listByAuthor(): string {
    return withCount("SELECT count(*) FROM (SELECT 1 FROM articles a WHERE a.author_id = (SELECT u.id FROM users u WHERE u.username = $4) LIMIT 1000) s", listPage("SELECT id FROM articles WHERE author_id = (SELECT au.id FROM users au WHERE au.username = $4) ORDER BY id DESC LIMIT $2 OFFSET $3"))
}

fn listByFavorited(): string {
    return withCount("SELECT count(*) FROM (SELECT 1 FROM favorites f WHERE f.user_id = (SELECT fu.id FROM users fu WHERE fu.username = $4) LIMIT 1000) s", listPage("SELECT f.article_id AS id FROM favorites f WHERE f.user_id = (SELECT fu.id FROM users fu WHERE fu.username = $4) ORDER BY f.article_id DESC LIMIT $2 OFFSET $3"))
}

fn listFeed(): string {
    return withCount("SELECT count(*) FROM (SELECT 1 FROM articles a WHERE a.author_id IN (SELECT fo.followee_id FROM follows fo WHERE fo.follower_id = $1) LIMIT 1000) s", listPage("SELECT x.id FROM follows fo CROSS JOIN LATERAL (SELECT a2.id FROM articles a2 WHERE a2.author_id = fo.followee_id ORDER BY a2.id DESC LIMIT ($2::int + $3::int)) x WHERE fo.follower_id = $1 ORDER BY x.id DESC LIMIT $2 OFFSET $3"))
}

fn articleBySlug(): string {
    return FULL_SELECT + " WHERE a.slug = $2"
}

fn articleById(): string {
    return FULL_SELECT + " WHERE a.id = $2"
}

fn insertArticle(): string {
    return "INSERT INTO articles (id, slug, author_id, title, description, body) SELECT n.id, " + SLUGIFY + " || '-' || n.id, $1, $2, $3, $4 FROM (SELECT nextval(pg_get_serial_sequence('articles', 'id')) AS id) n RETURNING id"
}

fn insertTags(): string {
    return "INSERT INTO tags (name) SELECT DISTINCT unnest($1::text[]) ON CONFLICT (name) DO NOTHING"
}

fn insertArticleTags(): string {
    return "INSERT INTO article_tags (article_id, tag_id) SELECT $1, t.id FROM tags t WHERE t.name = ANY($2::text[])"
}

fn ownArticle(): string {
    return "SELECT id, author_id FROM articles WHERE slug = $1"
}

fn updateArticle(): string {
    return "UPDATE articles SET title = COALESCE($2, title), description = COALESCE($3, description), body = COALESCE($4, body), slug = CASE WHEN $2::text IS NULL THEN slug ELSE " + SLUGIFY + " || '-' || id END, updated_at = now() WHERE id = $1"
}

fn deleteArticle(): string {
    return "DELETE FROM articles WHERE id = $1"
}

fn articleId(): string {
    return "SELECT id FROM articles WHERE slug = $1"
}

fn favorite(): string {
    return "INSERT INTO favorites (user_id, article_id) VALUES ($1, $2) ON CONFLICT DO NOTHING"
}

fn unfavorite(): string {
    return "DELETE FROM favorites WHERE user_id = $1 AND article_id = $2"
}

fn comments(): string {
    return "SELECT a.id, c.id, c.body, c.created_at, c.updated_at, c.username, c.bio, c.image, c.following FROM articles a LEFT JOIN LATERAL (SELECT c.id, c.body, c.created_at, c.updated_at, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = $1 AND fo.followee_id = c.author_id) AS following FROM comments c JOIN users u ON u.id = c.author_id WHERE c.article_id = a.id ORDER BY c.created_at DESC, c.id DESC LIMIT 100) c ON true WHERE a.slug = $2 ORDER BY c.created_at DESC, c.id DESC"
}

fn insertComment(): string {
    return "WITH c AS (INSERT INTO comments (article_id, author_id, body) VALUES ($1, $2, $3) RETURNING id, body, created_at, updated_at, author_id) SELECT c.id, c.body, c.created_at, c.updated_at, u.username, u.bio, u.image FROM c JOIN users u ON u.id = c.author_id"
}

fn commentAuthor(): string {
    return "SELECT c.author_id FROM comments c JOIN articles a ON a.id = c.article_id WHERE c.id = $1 AND a.slug = $2"
}

fn deleteComment(): string {
    return "DELETE FROM comments WHERE id = $1"
}
