const TAG_LIST: string = "ARRAY(SELECT (SELECT t.name FROM tags t WHERE t.id = at.tag_id) FROM article_tags at WHERE at.article_id = a.id ORDER BY 1) AS tag_list"

const BATCH: string = "unnest($1::int4[], $2::int8[], $3::int4[], $4::int4[], $5::text[]) r(i, v, l, o, k)"

fn viewerColumns(v: string): string {
    return "(SELECT count(*) FROM favorites f WHERE f.article_id = a.id) AS favorites_count, EXISTS (SELECT 1 FROM favorites f WHERE f.article_id = a.id AND f.user_id = " + v + ") AS favorited, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = " + v + " AND fo.followee_id = a.author_id) AS following"
}

fn fullSelect(v: string): string {
    return "SELECT a.id, a.slug, a.title, a.description, a.body, a.created_at, a.updated_at, " + TAG_LIST + ", " + viewerColumns(v) + " FROM articles a JOIN users u ON u.id = a.author_id"
}

fn withCount(count: string, list: string): string {
    return "SELECT n.total, l.* FROM (" + count + ") n(total) LEFT JOIN LATERAL (" + list + ") l ON true ORDER BY l.id DESC"
}

fn listPage(ids: string, v: string): string {
    return "SELECT a.id, a.slug, a.title, a.description, a.created_at, a.updated_at, " + TAG_LIST + ", " + viewerColumns(v) + " FROM (" + ids + ") p JOIN articles a ON a.id = p.id JOIN users u ON u.id = a.author_id ORDER BY a.id DESC"
}

fn batched(query: string, order: string): string {
    return "SELECT r.i, x.* FROM " + BATCH + " CROSS JOIN LATERAL (" + query + ") x ORDER BY r.i" + order
}

const SLUGIFY: string = "trim(both '-' from lower(regexp_replace($2, '[^A-Za-z0-9]+', '-', 'g')))"

fn tags(): string {
    return "SELECT name FROM tags ORDER BY name"
}

fn insertUser(): string {
    return "INSERT INTO users (username, email, password_hash) VALUES ($1, $2, $3) RETURNING id, username, email, bio, image"
}

fn login(): string {
    return "SELECT id, username, email, bio, image, password_hash FROM users WHERE email = $1"
}

fn userOf(v: string): string {
    return "SELECT id, username, email, bio, image FROM users WHERE id = " + v
}

fn userById(): string {
    return userOf("$1")
}

fn updateUser(): string {
    return "UPDATE users SET email = COALESCE($2, email), username = COALESCE($3, username), password_hash = COALESCE($4, password_hash), bio = COALESCE($5, bio), image = COALESCE($6, image) WHERE id = $1 RETURNING id, username, email, bio, image"
}

fn profileOf(v: string, k: string): string {
    return "SELECT u.id, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = " + v + " AND fo.followee_id = u.id) AS following FROM users u WHERE u.username = " + k
}

fn profile(): string {
    return profileOf("$1", "$2")
}

fn userByName(): string {
    return "SELECT id, username, bio, image FROM users WHERE username = $1"
}

fn follow(): string {
    return "INSERT INTO follows (follower_id, followee_id) VALUES ($1, $2) ON CONFLICT DO NOTHING"
}

fn unfollow(): string {
    return "DELETE FROM follows WHERE follower_id = $1 AND followee_id = $2"
}

fn countAll(): string {
    return "SELECT count(*) FROM (SELECT 1 FROM articles a LIMIT 1000) s"
}

fn idsAll(l: string, o: string): string {
    return "SELECT id FROM articles ORDER BY id DESC LIMIT " + l + " OFFSET " + o
}

fn countTag(k: string): string {
    return "SELECT count(*) FROM (SELECT 1 FROM article_tags at WHERE at.tag_id = (SELECT t.id FROM tags t WHERE t.name = " + k + ") LIMIT 1000) s"
}

fn idsTag(k: string, l: string, o: string): string {
    return "SELECT at.article_id AS id FROM article_tags at WHERE at.tag_id = (SELECT t.id FROM tags t WHERE t.name = " + k + ") ORDER BY at.article_id DESC LIMIT " + l + " OFFSET " + o
}

fn countAuthor(k: string): string {
    return "SELECT count(*) FROM (SELECT 1 FROM articles a WHERE a.author_id = (SELECT u.id FROM users u WHERE u.username = " + k + ") LIMIT 1000) s"
}

fn idsAuthor(k: string, l: string, o: string): string {
    return "SELECT id FROM articles WHERE author_id = (SELECT au.id FROM users au WHERE au.username = " + k + ") ORDER BY id DESC LIMIT " + l + " OFFSET " + o
}

fn countFavorited(k: string): string {
    return "SELECT count(*) FROM (SELECT 1 FROM favorites f WHERE f.user_id = (SELECT fu.id FROM users fu WHERE fu.username = " + k + ") LIMIT 1000) s"
}

fn idsFavorited(k: string, l: string, o: string): string {
    return "SELECT f.article_id AS id FROM favorites f WHERE f.user_id = (SELECT fu.id FROM users fu WHERE fu.username = " + k + ") ORDER BY f.article_id DESC LIMIT " + l + " OFFSET " + o
}

fn countFeed(v: string): string {
    return "SELECT count(*) FROM (SELECT 1 FROM articles a WHERE a.author_id IN (SELECT fo.followee_id FROM follows fo WHERE fo.follower_id = " + v + ") LIMIT 1000) s"
}

fn idsFeed(v: string, l: string, o: string): string {
    return "SELECT x.id FROM follows fo CROSS JOIN LATERAL (SELECT a2.id FROM articles a2 WHERE a2.author_id = fo.followee_id ORDER BY a2.id DESC LIMIT (" + l + "::int + " + o + "::int)) x WHERE fo.follower_id = " + v + " ORDER BY x.id DESC LIMIT " + l + " OFFSET " + o
}

fn listAllOf(v: string, l: string, o: string): string {
    return withCount(countAll(), listPage(idsAll(l, o), v))
}

fn listByTagOf(v: string, l: string, o: string, k: string): string {
    return withCount(countTag(k), listPage(idsTag(k, l, o), v))
}

fn listByAuthorOf(v: string, l: string, o: string, k: string): string {
    return withCount(countAuthor(k), listPage(idsAuthor(k, l, o), v))
}

fn listByFavoritedOf(v: string, l: string, o: string, k: string): string {
    return withCount(countFavorited(k), listPage(idsFavorited(k, l, o), v))
}

fn listFeedOf(v: string, l: string, o: string): string {
    return withCount(countFeed(v), listPage(idsFeed(v, l, o), v))
}

fn sharedList(key: string, count: string, ids: string): string {
    return "WITH r AS MATERIALIZED (SELECT * FROM " + BATCH + "), c AS MATERIALIZED (SELECT d.key, (" + count + ") AS total FROM (SELECT DISTINCT " + key + " AS key FROM r) d), g AS MATERIALIZED (SELECT DISTINCT " + key + " AS key, l, o FROM r), p AS MATERIALIZED (SELECT g.key, g.l, g.o, q.id FROM g CROSS JOIN LATERAL (" + ids + ") q), x AS MATERIALIZED (SELECT a.id, a.author_id, a.slug, a.title, a.description, a.created_at, a.updated_at, " + TAG_LIST + ", (SELECT count(*) FROM favorites f WHERE f.article_id = a.id) AS favorites_count, u.username, u.bio, u.image FROM (SELECT DISTINCT id FROM p) d CROSS JOIN LATERAL (SELECT * FROM articles ar WHERE ar.id = d.id LIMIT 1) a CROSS JOIN LATERAL (SELECT us.username, us.bio, us.image FROM users us WHERE us.id = a.author_id LIMIT 1) u) SELECT r.i, c.total, x.id, x.slug, x.title, x.description, x.created_at, x.updated_at, x.tag_list, x.favorites_count, CASE WHEN x.id IS NOT NULL THEN EXISTS (SELECT 1 FROM favorites f WHERE f.article_id = x.id AND f.user_id = r.v) END AS favorited, x.username, x.bio, x.image, CASE WHEN x.id IS NOT NULL THEN EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = r.v AND fo.followee_id = x.author_id) END AS following FROM r JOIN c ON c.key = r." + key + " LEFT JOIN p ON p.key = r." + key + " AND p.l = r.l AND p.o = r.o LEFT JOIN x ON x.id = p.id ORDER BY r.i, x.id DESC"
}

fn listAll(): string {
    return listAllOf("$1", "$2", "$3")
}

fn listByTag(): string {
    return listByTagOf("$1", "$2", "$3", "$4")
}

fn listByAuthor(): string {
    return listByAuthorOf("$1", "$2", "$3", "$4")
}

fn listByFavorited(): string {
    return listByFavoritedOf("$1", "$2", "$3", "$4")
}

fn listFeed(): string {
    return listFeedOf("$1", "$2", "$3")
}

fn articleBySlug(): string {
    return fullSelect("$1") + " WHERE a.slug = $2"
}

fn articleById(): string {
    return fullSelect("$1") + " WHERE a.id = $2"
}

fn insertArticle(): string {
    return "INSERT INTO articles (id, slug, author_id, title, description, body) SELECT n.id, " + SLUGIFY + " || '-' || n.id, $1, $2, $3, $4 FROM (SELECT nextval(pg_get_serial_sequence('articles', 'id')) AS id) n RETURNING id"
}

fn insertTags(): string {
    return "INSERT INTO tags (name) SELECT DISTINCT unnest($1::text[]) ON CONFLICT (name) DO NOTHING"
}

fn insertArticleTags(): string {
    return "INSERT INTO article_tags (article_id, tag_id) SELECT $1, t.id FROM tags t WHERE t.name = ANY($2::text[])"
}

fn ownArticle(): string {
    return "SELECT id, author_id FROM articles WHERE slug = $1"
}

fn updateArticle(): string {
    return "UPDATE articles SET title = COALESCE($2, title), description = COALESCE($3, description), body = COALESCE($4, body), slug = CASE WHEN $2::text IS NULL THEN slug ELSE " + SLUGIFY + " || '-' || id END, updated_at = now() WHERE id = $1"
}

fn deleteArticle(): string {
    return "DELETE FROM articles WHERE id = $1"
}

fn articleId(): string {
    return "SELECT id FROM articles WHERE slug = $1"
}

fn favorite(): string {
    return "INSERT INTO favorites (user_id, article_id) VALUES ($1, $2) ON CONFLICT DO NOTHING"
}

fn unfavorite(): string {
    return "DELETE FROM favorites WHERE user_id = $1 AND article_id = $2"
}

fn commentsOf(v: string, k: string): string {
    return "SELECT a.id AS article_id, c.id, c.body, c.created_at, c.updated_at, c.username, c.bio, c.image, c.following FROM articles a LEFT JOIN LATERAL (SELECT c.id, c.body, c.created_at, c.updated_at, u.username, u.bio, u.image, EXISTS (SELECT 1 FROM follows fo WHERE fo.follower_id = " + v + " AND fo.followee_id = c.author_id) AS following FROM comments c JOIN users u ON u.id = c.author_id WHERE c.article_id = a.id ORDER BY c.created_at DESC, c.id DESC LIMIT 100) c ON true WHERE a.slug = " + k + " ORDER BY c.created_at DESC, c.id DESC"
}

fn comments(): string {
    return commentsOf("$1", "$2")
}

fn batchUser(): string {
    return batched(userOf("r.v"), "")
}

fn batchProfile(): string {
    return batched(profileOf("r.v", "r.k"), "")
}

fn batchArticle(): string {
    return batched(fullSelect("r.v") + " WHERE a.slug = r.k", "")
}

fn batchComments(): string {
    return batched(commentsOf("r.v", "r.k"), ", x.created_at DESC, x.id DESC")
}

fn batchListAll(): string {
    return sharedList("k", countAll(), idsAll("g.l", "g.o"))
}

fn batchListTag(): string {
    return sharedList("k", countTag("d.key"), idsTag("g.key", "g.l", "g.o"))
}

fn batchListAuthor(): string {
    return sharedList("k", countAuthor("d.key"), idsAuthor("g.key", "g.l", "g.o"))
}

fn batchListFavorited(): string {
    return sharedList("k", countFavorited("d.key"), idsFavorited("g.key", "g.l", "g.o"))
}

fn batchListFeed(): string {
    return sharedList("v", countFeed("d.key"), idsFeed("g.key", "g.l", "g.o"))
}

fn insertComment(): string {
    return "WITH c AS (INSERT INTO comments (article_id, author_id, body) VALUES ($1, $2, $3) RETURNING id, body, created_at, updated_at, author_id) SELECT c.id, c.body, c.created_at, c.updated_at, u.username, u.bio, u.image FROM c JOIN users u ON u.id = c.author_id"
}

fn commentAuthor(): string {
    return "SELECT c.author_id FROM comments c JOIN articles a ON a.id = c.article_id WHERE c.id = $1 AND a.slug = $2"
}

fn deleteComment(): string {
    return "DELETE FROM comments WHERE id = $1"
}
