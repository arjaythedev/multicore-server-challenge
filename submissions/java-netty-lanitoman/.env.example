# Environment for start.sh. On the benchmark box these come from /etc/challenge/env (SPEC.md, "Runtime contract").
# Locally: cp .env.example .env, edit, then: set -a; . ./.env; set +a; ./start.sh

# Required
DATABASE_URL=postgres://conduit:conduit@127.0.0.1:5432/conduit
JWT_SECRET=multicore-server-challenge
# 0.0.0.0 and 80 when serving directly (this submission is Front: direct); 127.0.0.1 and 3000 behind Nginx
HOST=0.0.0.0
PORT=80

# Optional tuning (the defaults are shown)
# HTTP_THREADS=2
# PG_THREADS=2
# DB_READ_CONNS=10
# DB_WRITE_CONNS=16
# BATCH_MAX=64
# BCRYPT_THREADS=2
# BCRYPT_BATCH_WINDOW_MS=400
# BCRYPT_NICE=10
# default: the file descriptor limit less 1% and 1000 (197000 with the box's LimitNOFILE=200000)
# MAX_CONNECTIONS=197000
# DB_OPTIONS="-c plan_cache_mode=force_generic_plan -c jit=off -c max_parallel_workers_per_gather=0"
# JAVA_OPTS=
# PREFIX=/usr/local/conduit
